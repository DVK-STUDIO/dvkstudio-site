---
import Base from "../layouts/Base.astro";
import ExperienceDemo from "../components/ExperienceDemo.astro";
import { experiencesPubliables } from "../lib/experience/experience";
const experiences = experiencesPubliables();
---

<Base
  titre="DVK Expérience : comprendre un bien, ses travaux et son budget"
  description="DVK Expérience relie le bien, son potentiel, les travaux, le budget et la performance énergétique, avec la source et le statut de chaque donnée."
  page="experience"
  chemin="/experience/"
>
  <header class="conteneur page-hero">
    <p class="surtitre">DVK Expérience</p>
    <h1 class="titre-xl">Ne regardez plus seulement un bien. Découvrez ce qu'il peut devenir.</h1>
    <p class="chapo">Du bien réel à la décision : comprendre ce qu'on achète, ce qu'on pourrait en faire, ce que cela coûterait et ce que chaque option apporte ou laisse de côté.</p>
  </header>

  <ExperienceDemo experience={experiences[0]} />

  <section class="section conteneur" aria-labelledby="t-promesse">
    <h2 id="t-promesse" class="titre-l" style="max-width:24ch">Ce qui distingue DVK Expérience.</h2>
    <div class="bloc">
      <div><h3>Cohérence</h3><p>Ce qu'on montre, ce qu'on chiffre et ce qui est réalisable restent alignés. Un scénario n'est pas qu'une liste de travaux : il dit quels besoins il couvre.</p></div>
      <div><h3>Honnêteté</h3><p>Chaque donnée porte sa source et son statut : réel, estimation, hypothèse, projection ou à venir. Ce qui manque s'affiche comme manquant.</p></div>
      <div><h3>Partage</h3><p>À terme, une page propre à chaque bien, qu'un agent peut transmettre à un acquéreur.</p></div>
    </div>
    {experiences.length > 1 && (<>
      <h3 class="titre-m" style="margin-top:56px">Une expérience réelle</h3>
      <ul class="experiences">
        {experiences.map((x) => (
          <li>
            <a href={`/experience/${x.slug}/`}>
              <span class="dvk-availability is-demo">Projet pilote</span>
              <strong>{x.titre}</strong>
              <span>{x.accroche}</span>
              <span class="aller">Découvrir l'expérience →</span>
            </a>
          </li>
        ))}
      </ul>
    </>)}
  </section>
</Base>

<style>
  .experiences { list-style: none; padding: 0; margin-top: 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 20px; }
  .experiences a { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; padding: 24px; border: 1px solid var(--ligne); border-radius: var(--dvk-radius-md); background: var(--papier-2); height: 100%; }
  .experiences strong { font-family: var(--serif); font-size: 26px; font-weight: 600; line-height: 1.15; }
  .experiences span:not(.dvk-availability) { color: var(--encre-douce); font-size: 16px; }
  .experiences .aller { color: var(--terre-fonce); font-weight: 600; margin-top: auto; }
</style>

