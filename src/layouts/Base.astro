---
import "@fontsource-variable/montserrat";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import "../styles/global.css";
import montserratLatin from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";
import frauncesLatin from "@fontsource/fraunces/files/fraunces-latin-500-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";

interface Props {
  titre: string;
  description: string;
  page: string; // identifiant d'attribution : home, immobilier, travaux…
  chemin: string;
  noindex?: boolean;
  /** Données structurées (schema.org), sérialisées en JSON-LD. Uniquement des faits publics déjà affichés sur le site. */
  donneesStructurees?: Record<string, unknown>;
}
const { titre, description, page, chemin, noindex = false, donneesStructurees } = Astro.props;
const canonique = new URL(chemin, site.url).toString();
const titreComplet = titre.includes("DVK Studio") ? titre : `${titre} | DVK Studio`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <!-- Polices du premier écran (latin) préchargées : moins de décalage au chargement. Le reste se charge à la demande. -->
    <link rel="preload" href={montserratLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {donneesStructurees && <script type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="theme-color" content="#1c1c1c" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <!-- Pixel OpenAI Ads (ChatGPT Ads) -->
    <script is:inline>
      (function (w, d, s, u) {
        if (w.oaiq) return;
        var q = function () {
          q.q.push(arguments);
        };
        q.q = [];
        w.oaiq = q;
        var js = d.createElement(s);
        js.async = true;
        js.src = u;
        var f = d.getElementsByTagName(s)[0];
        f.parentNode.insertBefore(js, f);
      })(window, document, "script", "https://bzrcdn.openai.com/sdk/oaiq.min.js");

      oaiq("init", {
        pixelId: "Lekx9MQJutG5K2J1qTPb4M",
      });
      oaiq("measure", "page_viewed", { type: "contents" });
    </script>
  </head>
  <body data-page={page}>
    <a class="aller-contenu" href="#contenu">Aller au contenu</a>
    <Header page={page} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />

    <!-- Silhouette latérale architecte du Zèbre (Desktop) -->
    <aside class="dvk-zebre-lateral" aria-hidden="true">
      <img
        src="/images/avatar/dvk-zebre-plein-pied.png"
        alt=""
        width="405"
        height="1026"
        loading="lazy"
        decoding="async"
      />
    </aside>
    <script is:inline>
      // Mesure des visites Metricool — identifiant fourni par DVK Studio.
      (() => {
        const script = document.createElement("script");
        script.src = "https://tracker.metricool.com/resources/be.js";
        script.async = true;
        script.onload = () => {
          if (window.beTracker && typeof window.beTracker.t === "function") {
            window.beTracker.t({ hash: "c37a4ed28c436dab4dbaadc917bb1007" });
          }
        };
        document.head.appendChild(script);
      })();
    </script>
    <script>
      // Origine du visiteur (sans cookie) et liens de rendez-vous. Chargé sur toutes les pages.
      import { RDV_BASE, construireLienRdv, fusionnerOrigine, lireAttribution, offreDepuisChemin, type Attribution } from "../lib/rdv";
      import { signalConversion } from "../lib/conversion.mjs";
      const signaler = (evenement: string, bouton?: string) => {
        const detail = signalConversion(evenement, document.body.dataset.page, bouton);
        if (detail) window.dispatchEvent(new CustomEvent("dvk:conversion", { detail }));
      };
      signaler("page_vue");
      if (document.body.dataset.page === "merci" && typeof (window as any).oaiq === "function") {
        (window as any).oaiq("measure", "appointment_scheduled", { type: "customer_action" });
      }
      document.addEventListener("click", event => {
        const cible = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href]") : null;
        if (!cible) return;
        if (cible.hasAttribute("data-rdv")) {
          signaler("rdv_ouvert", cible.dataset.rdv);
          if (typeof (window as any).oaiq === "function") {
            (window as any).oaiq("measure", "appointment_scheduled", { type: "customer_action" });
          }
        }
        else if (cible.protocol === "tel:") {
          signaler("appel_ouvert");
          if (typeof (window as any).oaiq === "function") {
            (window as any).oaiq("measure", "lead_created", { type: "customer_action" });
          }
        }
        else if (cible.protocol === "mailto:") {
          signaler("email_ouvert");
          if (typeof (window as any).oaiq === "function") {
            (window as any).oaiq("measure", "lead_created", { type: "customer_action" });
          }
        }
      });
      const CLE = "dvk_origine";
      let origine: Attribution | null = null;
      try {
        const stockee = sessionStorage.getItem(CLE);
        origine = stockee ? (JSON.parse(stockee) as Attribution) : null;
        origine = fusionnerOrigine(origine, lireAttribution(location.search, document.referrer, location.pathname, location.hostname));
        sessionStorage.setItem(CLE, JSON.stringify(origine));
      } catch {
        origine = lireAttribution(location.search, document.referrer, location.pathname, location.hostname);
      }
      const page = document.body.dataset.page ?? "page";
      document.querySelectorAll<HTMLAnchorElement>("a[data-rdv]").forEach((a) => {
        a.href = construireLienRdv(RDV_BASE, origine, { page, bouton: a.dataset.rdv ?? "rdv", parcours: a.dataset.parcours, offre: offreDepuisChemin(location.pathname) });
        a.target = "_blank";
        a.rel = "noopener";
      });

      // Apparition douce au scroll (jamais bloquante).
      const cibles = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window) {
        const obs = new IntersectionObserver((entrees) => entrees.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("vu"); obs.unobserve(e.target); } }), { rootMargin: "0px 0px -8% 0px" });
        cibles.forEach((c) => obs.observe(c));
      } else cibles.forEach((c) => c.classList.add("vu"));
    </script>
        <!-- Chatbot officiel Le Zèbre DVK Studio (Typebot AI) -->
    <script type="module" is:inline>
      import Typebot from "https://cdn.jsdelivr.net/npm/@typebot.io/js@0.3/dist/web.js";

      Typebot.initBubble({
        typebot: "dvk-studio-le-z-bre-ai-nouvelle-g-n-ration-hemea-oise-60-somme-80-xgncoix",
        apiHost: "https://typebot.co",
        theme: {
          button: {
            backgroundColor: "#0B4B66",
            customIconSrc: "https://dvkstudio.fr/images/dvk-zebre-avatar-chatbot-v2.png",
            customIconUrl: "https://dvkstudio.fr/images/dvk-zebre-avatar-chatbot-v2.png",
            size: "large",
          },
          chatWindow: {
            maxWidth: "440px",
            maxHeight: "720px",
          },
          previewMessage: {
            avatarUrl: "https://dvkstudio.fr/images/dvk-zebre-avatar-chatbot-v2.png",
          },
          chat: {
            hostAvatar: {
              isEnabled: true,
              url: "https://dvkstudio.fr/images/dvk-zebre-avatar-chatbot-v2.png",
            },
          },
        },
      });

      // Style officiel Avatar Portrait circulaire pour la bulle Le Zèbre et correctif des boutons du chat
      const appliquerStyleAvatarZebre = () => {
        const bubble = document.querySelector("typebot-bubble");
        if (bubble && bubble.shadowRoot) {
          const btnImg = bubble.shadowRoot.querySelector('img[part="button-icon"]');
          if (btnImg && (!btnImg.src || !btnImg.src.includes("-v2.png"))) {
            btnImg.src = "https://dvkstudio.fr/images/dvk-zebre-avatar-chatbot-v2.png";
          }
          if (!bubble.shadowRoot.querySelector("#dvk-zebre-bubble-style")) {
            const style = document.createElement("style");
            style.id = "dvk-zebre-bubble-style";
            const rProp = "border-" + "radius";
            const fProp = "font-" + "family";
            style.textContent = `
              /* 1. Bouton flottant officiel Le Zèbre (bulle de lancement) */
              button[part="button"] {
                ${rProp}: 50% !important;
                border: 3px solid #C85E2C !important;
                box-shadow: 0 8px 24px rgba(11, 75, 102, 0.35) !important;
                overflow: hidden !important;
                width: 66px !important;
                height: 66px !important;
                padding: 0 !important;
                background-color: #0B4B66 !important;
                transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease !important;
              }
              button[part="button"]:hover {
                transform: scale(1.05) !important;
                box-shadow: 0 10px 28px rgba(200, 94, 44, 0.45) !important;
              }
              button[part="button"] img[part="button-icon"] {
                ${rProp}: 50% !important;
                object-fit: contain !important;
                width: 100% !important;
                height: 100% !important;
                transform: none !important;
              }
              button[part="button"] svg[part="button-icon"] {
                width: 28px !important;
                height: 28px !important;
                color: #FFFFFF !important;
                margin: auto !important;
              }

              /* 2. Rétablissement des boutons de choix / raccourcis dans la conversation */
              button.typebot-button,
              .typebot-button,
              div[part="bot"] button:not([part="button"]) {
                width: 100% !important;
                max-width: 100% !important;
                min-height: 48px !important;
                height: auto !important;
                ${rProp}: 12px !important;
                border: 1.5px solid #0B4B66 !important;
                background-color: #0B4B66 !important;
                color: #FFFFFF !important;
                padding: 12px 18px !important;
                ${fProp}: var(--dvk-font), sans-serif !important;
                font-size: 14.5px !important;
                font-weight: 600 !important;
                line-height: 1.35 !important;
                text-align: left !important;
                white-space: normal !important;
                word-break: break-word !important;
                overflow: visible !important;
                box-shadow: 0 2px 8px rgba(11, 75, 102, 0.15) !important;
                display: flex !important;
                align-items: center !important;
                justify-content: flex-start !important;
                margin: 4px 0 !important;
                cursor: pointer !important;
                box-sizing: border-box !important;
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
              }
              button.typebot-button:hover,
              .typebot-button:hover,
              div[part="bot"] button:not([part="button"]):hover {
                background-color: #C85E2C !important;
                border-color: #C85E2C !important;
                color: #FFFFFF !important;
                transform: translateY(-2px) !important;
                box-shadow: 0 6px 18px rgba(200, 94, 44, 0.35) !important;
              }

              /* Conteneur des boutons pour occuper toute la largeur disponible */
              .typebot-buttons-container,
              div[part="bot"] .typebot-buttons-container {
                width: 100% !important;
                max-width: 100% !important;
                display: flex !important;
                flex-direction: column !important;
                gap: 8px !important;
              }

              /* 3. Avatar du Zèbre dans la conversation */
              .typebot-avatar-container {
                width: 44px !important;
                min-width: 44px !important;
                height: 44px !important;
                margin-right: 10px !important;
              }
              .typebot-avatar-container > div {
                width: 44px !important;
                height: 44px !important;
              }
              .typebot-avatar-container img {
                width: 44px !important;
                height: 44px !important;
                ${rProp}: 50% !important;
                object-fit: cover !important;
                border: 2px solid #C85E2C !important;
                box-shadow: 0 2px 8px rgba(11, 75, 102, 0.2) !important;
                background-color: #0B4B66 !important;
              }

              /* 4. Bulles de message Le Zèbre */
              .typebot-host-bubble {
                ${rProp}: 14px !important;
                padding: 14px 18px !important;
                font-size: 15px !important;
                line-height: 1.55 !important;
                box-shadow: 0 4px 16px rgba(11, 75, 102, 0.08) !important;
                border: 1px solid #E6DEC8 !important;
              }

              /* Ajustements mobiles optimisés */
              @media (max-width: 720px) {
                button[part="button"] {
                  width: 58px !important;
                  height: 58px !important;
                  border-width: 2.5px !important;
                }
                .typebot-avatar-container,
                .typebot-avatar-container > div,
                .typebot-avatar-container img {
                  width: 36px !important;
                  height: 36px !important;
                  min-width: 36px !important;
                }
                .typebot-host-bubble {
                  padding: 12px 14px !important;
                  font-size: 14px !important;
                }
              }
            `;
            bubble.shadowRoot.appendChild(style);
          }
        }
      };

      const observer = new MutationObserver(() => {
        appliquerStyleAvatarZebre();
      });
      observer.observe(document.body, { childList: true, subtree: true });
      setTimeout(appliquerStyleAvatarZebre, 100);
      setTimeout(appliquerStyleAvatarZebre, 500);
      setTimeout(appliquerStyleAvatarZebre, 1500);
    </script>
  </body>
</html>