---
import "@fontsource-variable/montserrat";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import "../styles/global.css";
import montserratLatin from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";
import frauncesLatin from "@fontsource/fraunces/files/fraunces-latin-500-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";

interface Props {
  titre: string;
  description: string;
  page: string; // identifiant d'attribution : home, immobilier, travaux…
  chemin: string;
  noindex?: boolean;
  /** Données structurées (schema.org), sérialisées en JSON-LD. Uniquement des faits publics déjà affichés sur le site. */
  donneesStructurees?: Record<string, unknown>;
}
const { titre, description, page, chemin, noindex = false, donneesStructurees } = Astro.props;
const canonique = new URL(chemin, site.url).toString();
const titreComplet = titre.includes("DVK Studio") ? titre : `${titre} | DVK Studio`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <!-- Polices du premier écran (latin) préchargées : moins de décalage au chargement. Le reste se charge à la demande. -->
    <link rel="preload" href={montserratLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {donneesStructurees && <script type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="theme-color" content="#1c1c1c" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <!-- Pixel OpenAI Ads (ChatGPT Ads) -->
    <script is:inline>
      (function (w, d, s, u) {
        if (w.oaiq) return;
        var q = function () {
          q.q.push(arguments);
        };
        q.q = [];
        w.oaiq = q;
        var js = d.createElement(s);
        js.async = true;
        js.src = u;
        var f = d.getElementsByTagName(s)[0];
        f.parentNode.insertBefore(js, f);
      })(window, document, "script", "https://bzrcdn.openai.com/sdk/oaiq.min.js");

      oaiq("init", {
        pixelId: "Lekx9MQJutG5K2J1qTPb4M",
      });
      oaiq("measure", "page_viewed", { type: "contents" });
    </script>
  </head>
  <body data-page={page}>
    <a class="aller-contenu" href="#contenu">Aller au contenu</a>
    <Header page={page} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Mesure des visites Metricool — identifiant fourni par DVK Studio.
      (() => {
        const script = document.createElement("script");
        script.src = "https://tracker.metricool.com/resources/be.js";
        script.async = true;
        script.onload = () => {
          if (window.beTracker && typeof window.beTracker.t === "function") {
            window.beTracker.t({ hash: "c37a4ed28c436dab4dbaadc917bb1007" });
          }
        };
        document.head.appendChild(script);
      })();
    </script>
    <script>
      // Origine du visiteur (sans cookie) et liens de rendez-vous. Chargé sur toutes les pages.
      import { RDV_BASE, construireLienRdv, fusionnerOrigine, lireAttribution, offreDepuisChemin, type Attribution } from "../lib/rdv";
      import { signalConversion } from "../lib/conversion.mjs";
      const signaler = (evenement: string, bouton?: string) => {
        const detail = signalConversion(evenement, document.body.dataset.page, bouton);
        if (detail) window.dispatchEvent(new CustomEvent("dvk:conversion", { detail }));
      };
      signaler("page_vue");
      if (document.body.dataset.page === "merci" && typeof (window as any).oaiq === "function") {
        (window as any).oaiq("measure", "appointment_scheduled", { type: "customer_action" });
      }
      document.addEventListener("click", event => {
        const cible = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href]") : null;
        if (!cible) return;
        if (cible.hasAttribute("data-rdv")) {
          signaler("rdv_ouvert", cible.dataset.rdv);
          if (typeof (window as any).oaiq === "function") {
            (window as any).oaiq("measure", "appointment_scheduled", { type: "customer_action" });
          }
        }
        else if (cible.protocol === "tel:") {
          signaler("appel_ouvert");
          if (typeof (window as any).oaiq === "function") {
            (window as any).oaiq("measure", "lead_created", { type: "customer_action" });
          }
        }
        else if (cible.protocol === "mailto:") {
          signaler("email_ouvert");
          if (typeof (window as any).oaiq === "function") {
            (window as any).oaiq("measure", "lead_created", { type: "customer_action" });
          }
        }
      });
      const CLE = "dvk_origine";
      let origine: Attribution | null = null;
      try {
        const stockee = sessionStorage.getItem(CLE);
        origine = stockee ? (JSON.parse(stockee) as Attribution) : null;
        origine = fusionnerOrigine(origine, lireAttribution(location.search, document.referrer, location.pathname, location.hostname));
        sessionStorage.setItem(CLE, JSON.stringify(origine));
      } catch {
        origine = lireAttribution(location.search, document.referrer, location.pathname, location.hostname);
      }
      const page = document.body.dataset.page ?? "page";
      document.querySelectorAll<HTMLAnchorElement>("a[data-rdv]").forEach((a) => {
        a.href = construireLienRdv(RDV_BASE, origine, { page, bouton: a.dataset.rdv ?? "rdv", parcours: a.dataset.parcours, offre: offreDepuisChemin(location.pathname) });
        a.target = "_blank";
        a.rel = "noopener";
      });

      // Apparition douce au scroll (jamais bloquante).
      const cibles = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window) {
        const obs = new IntersectionObserver((entrees) => entrees.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("vu"); obs.unobserve(e.target); } }), { rootMargin: "0px 0px -8% 0px" });
        cibles.forEach((c) => obs.observe(c));
      } else cibles.forEach((c) => c.classList.add("vu"));
    </script>
        <!-- Chatbot officiel Le Zèbre DVK Studio (Typebot AI) -->
    <script type="module" is:inline>
      import Typebot from "https://cdn.jsdelivr.net/npm/@typebot.io/js@0.3/dist/web.js";

      Typebot.initBubble({
        typebot: "dvk-studio-le-z-bre-ai-nouvelle-g-n-ration-hemea-oise-60-somme-80-xgncoix",
        apiHost: "https://typebot.co",
        theme: {
          button: {
            backgroundColor: "#0B4B66",
            customIconSrc: "https://dvkstudio.fr/images/dvk-zebre-avatar-chatbot.png",
            customIconUrl: "https://dvkstudio.fr/images/dvk-zebre-avatar-chatbot.png",
            size: "large",
          },
          previewMessage: {
            avatarUrl: "https://dvkstudio.fr/images/dvk-zebre-avatar-chatbot.png",
          },
        },
      });

      // Style officiel Avatar Portrait circulaire pour la bulle Le Zèbre
      const appliquerStyleAvatarZebre = () => {
        const bubble = document.querySelector("typebot-bubble");
        if (bubble && bubble.shadowRoot) {
          if (!bubble.shadowRoot.querySelector("#dvk-zebre-bubble-style")) {
            const style = document.createElement("style");
            style.id = "dvk-zebre-bubble-style";
            const rProp = "border-" + "radius";
            style.textContent = `
              button {
                ${rProp}: 50% !important;
                border: 3px solid #C85E2C !important;
                box-shadow: 0 8px 24px rgba(11, 75, 102, 0.35) !important;
                overflow: hidden !important;
                width: 68px !important;
                height: 68px !important;
                padding: 0 !important;
              }
              button img {
                ${rProp}: 50% !important;
                object-fit: cover !important;
                width: 100% !important;
                height: 100% !important;
                transform: scale(1.05) !important;
              }
            `;
            bubble.shadowRoot.appendChild(style);
          }
        }
      };

      const observer = new MutationObserver(() => {
        appliquerStyleAvatarZebre();
      });
      observer.observe(document.body, { childList: true, subtree: true });
      setTimeout(appliquerStyleAvatarZebre, 100);
      setTimeout(appliquerStyleAvatarZebre, 500);
      setTimeout(appliquerStyleAvatarZebre, 1500);
    </script>
  </body>
</html>