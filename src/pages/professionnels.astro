---
import Base from "../layouts/Base.astro";
import BoutonRdv from "../components/BoutonRdv.astro";
import Processus from "../components/Processus.astro";
import Faq from "../components/Faq.astro";
import { site } from "../content/site";
const mailto = `mailto:${site.email}?subject=${encodeURIComponent("Projet travaux d'un client — Oise / Somme")}`;
const faq = [
  { q: "À qui s'adresse ce parcours ?", r: "Aux agents immobiliers, chasseurs immobiliers, courtiers et autres professionnels qui accompagnent un client ayant un projet de rénovation dans l'Oise ou la Somme." },
  { q: "Quand vous solliciter ?", r: "Dès qu'une question travaux se pose : bien à rénover, enveloppe à préciser ou besoin d'un interlocuteur pour préparer la suite. Je vérifie avec vous si l'accompagnement hemea correspond au projet." },
  { q: "Que vous envoyer au premier contact ?", r: "La commune du bien, une description des travaux et le calendrier envisagé suffisent pour commencer. Pour transmettre les coordonnées ou des documents de votre client, obtenez d'abord son accord ; vous pouvez aussi lui transmettre directement mes coordonnées." },
  { q: "Remplacez-vous mon rôle auprès du client ?", r: "Vous conservez votre rôle dans son projet immobilier. Mon intervention porte sur le projet travaux, dans le cadre de l'accompagnement hemea." },
];
---
<Base titre="Prescripteurs immobiliers : un contact travaux hemea | Oise et Somme"
  description="Agents immobiliers, chasseurs et courtiers dans l'Oise et la Somme : Kevin De Vlieger, chef de projet travaux hemea, accompagne les projets de rénovation de vos clients."
  page="professionnels" chemin="/professionnels/">
  <header class="conteneur page-hero">
    <p class="surtitre">Prescripteurs immobiliers · {site.zone}</p>
    <h1 class="titre-xl">Le projet immobilier est le vôtre.<br />Parlons des travaux de votre client.</h1>
    <p class="chapo">Un acquéreur s'interroge sur une rénovation ? Un client souhaite faire le point sur ses travaux ? Je suis votre interlocuteur local hemea pour cadrer son besoin et préparer les prochaines étapes.</p>
    <div class="actions"><BoutonRdv bouton="hero.partenariat" parcours="pro">Parler d'un projet client</BoutonRdv><a class="btn btn-contour" href={mailto}>M'écrire directement</a></div>
  </header>
  <section class="section conteneur" aria-labelledby="t-besoin">
    <h2 id="t-besoin" class="titre-l">Quand les travaux entrent dans la conversation.</h2>
    <div class="bloc">
      <div><h3>Un achat avec rénovation</h3><p>Votre acquéreur souhaite comprendre les travaux à envisager et le budget à approfondir avant de poursuivre son projet.</p></div>
      <div><h3>Un besoin à clarifier</h3><p>Votre client a des idées, mais doit encore définir ses priorités, son calendrier et les prochaines étapes.</p></div>
      <div><h3>Un contact pour la suite</h3><p>Vous cherchez un interlocuteur pour préparer le projet travaux et consulter des entreprises labellisées hemea.</p></div>
    </div>
  </section>
  <section class="papier-2 section" aria-labelledby="t-fonctionnement">
    <div class="conteneur">
      <p class="surtitre">Une mise en relation simple</p>
      <h2 id="t-fonctionnement" class="titre-l" style="margin-top:24px">De votre client à son projet travaux.</h2>
      <div style="margin-top:40px"><Processus variant="liste" etapes={[
        { titre: "Un premier échange", texte: "La commune, le type de bien, les travaux envisagés et le calendrier." },
        { titre: "Vous proposez le contact", texte: "Transmettez mes coordonnées à votre client, ou proposez une mise en relation avec son accord." },
        { titre: "Je cadre son besoin", texte: "Un premier échange permet de préciser les attentes et de vérifier l'adéquation avec l'accompagnement hemea." },
        { titre: "Le projet avance", texte: "Les prochaines étapes sont définies selon le besoin et le périmètre convenu." },
      ]} /></div>
      <div class="actions"><a class="btn btn-encre" href={site.telephoneLien}>Appeler Kevin · {site.telephone}</a></div>
    </div>
  </section>
  <section class="section conteneur" aria-labelledby="t-faq"><h2 id="t-faq" class="titre-m" style="margin-bottom:32px">Vos questions</h2><Faq questions={faq} /><div class="actions"><BoutonRdv bouton="faq.rdv" parcours="pro">Échanger sur un projet</BoutonRdv></div></section>
</Base>

