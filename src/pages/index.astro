---
import Base from "../layouts/Base.astro";
import BoutonRdv from "../components/BoutonRdv.astro";
import BarreRdv from "../components/BarreRdv.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Processus from "../components/Processus.astro";
import Plan from "../components/Plan.astro";
import Faq from "../components/Faq.astro";
import Statut from "../components/experience/Statut.astro";
import { experiencesPubliables } from "../lib/experience/experience";
import { hero, site } from "../content/site";
import { iadActive } from "../content/capacites";
import { iad } from "../content/iad";

// Hero interchangeable : le curseur avant/après n'est actif que si le mode l'autorise ET que les deux images
// existent dans src/assets/hero/ (avant.*, apres.*). Sinon, plan annoté.
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/hero/*.{webp,jpg,jpeg,png}", { eager: true });
const trouver = (nom: string) => Object.entries(images).find(([chemin]) => new RegExp(`/${nom}\\.`).test(chemin))?.[1].default;
const avant = trouver("avant");
const apres = trouver("apres");
const heroAvantApres = hero.mode === "avantApres" && avant && apres;

// Aperçu réel de DVK Expérience : uniquement si une expérience est publiable (diffusion confirmée en build public).
const experience = experiencesPubliables()[0];

// Données structurées : uniquement des faits publics déjà affichés (nom, coordonnées, zone). Rien sur les réseaux partenaires.
const entreprise = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.nom,
  url: site.url,
  telephone: "+33640324752",
  email: site.email,
  address: { "@type": "PostalAddress", streetAddress: "17 Rue Machaut", postalCode: "60120", addressLocality: "Gannes", addressCountry: "FR" },
  areaServed: "Oise",
  sameAs: [site.reseaux.instagram, site.reseaux.linkedin],
};

// Où en êtes-vous ? Trois situations. Une entrée supplémentaire n'apparaît que si la capacité correspondante est active.
const situations = [
  { titre: "Je rénove", texte: "Cadrer mes travaux et mon budget avant de m'engager.", lien: "Cadrer mes travaux →", href: "/travaux/" },
  { titre: "J'achète un bien à rénover", texte: "Comprendre son potentiel et le coût des travaux avant de signer, pour l'habiter ou le louer.", lien: "Analyser un bien →", href: "/acquereurs/" },
  { titre: "Je suis professionnel", texte: "Montrer à vos acquéreurs ce qu'un bien peut devenir.", lien: "Envoyer une annonce →", href: "/professionnels/" },
  ...(iadActive ? [iad.accueil.entree] : []),
];

const faq = [
  { q: "Faites-vous les travaux ?", r: "Non. DVK Studio n'est pas maître d'œuvre et ne réalise pas de travaux. Il cadre votre projet, estime son budget et vous aide à consulter des entreprises." },
  { q: "Les budgets présentés sont-ils des devis ?", r: "Non. Ce sont des estimations indicatives, avec leurs hypothèses et leurs limites. Un devis ne vient qu'avec les entreprises consultées." },
  { q: "Combien coûte le premier échange ?", r: "Vingt minutes par téléphone, sans engagement. Les conditions de chaque prestation vous sont communiquées avant tout engagement." },
  ...(iadActive ? [iad.accueil.faq] : []),
  { q: "Où intervenez-vous ?", r: `${site.zone}, lorsque le projet s'y prête.` },
];
---

<Base
  titre="DVK Studio — Comprendre le potentiel d'un bien, ses travaux et leur budget"
  description="Chef de projet travaux en Oise : DVK Studio vous aide à comprendre le potentiel d'un bien, ses travaux et leur budget avant de décider. Un seul interlocuteur."
  page="home"
  chemin="/"
  donneesStructurees={entreprise}
>
  <!-- 1 · Hero : la promesse, le rendez-vous, un aperçu de ce que reçoit le client -->
  <section class="hero conteneur" aria-labelledby="titre-hero">
    <div class="hero-grille">
      <div class="hero-texte">
        <p class="surtitre">Chef de projet travaux · {site.zone}</p>
        <h1 id="titre-hero" class="titre-xl">Ne regardez plus seulement un bien. Découvrez ce qu'il peut devenir.</h1>
        <p class="chapo">DVK Studio vous aide à comprendre le potentiel d'un bien, ses travaux et leur budget, avant de décider. Un seul interlocuteur, et des chiffres qui disent s'ils sont réels, estimés ou supposés.</p>
        <div class="hero-actions">
          <BoutonRdv bouton="hero.rdv">Prendre rendez-vous · 20 min</BoutonRdv>
          <a class="btn btn-contour" href="/experience/">Découvrir DVK Expérience</a>
        </div>
        <p class="micro">Par téléphone, sans engagement.</p>
      </div>
      <div class="hero-visuel">
        {heroAvantApres ? (
          <BeforeAfter id="hero" avant={avant} apres={apres} altAvant="Pièce dans son état actuel" altApres="Projection de la même pièce transformée" legende={hero.avantApres.legende} />
        ) : (
          <Plan
            alt="Plan schématique d'une maison : la cuisine, le séjour et la cloison qui les sépare"
            zones={["cuisine"]}
            ouverture
            annotations={[
              { x: 42.5, y: 26, lx: 52, ly: 8, libelle: "Cloison : porteuse ou non ?", statut: "manquant" },
              { x: 42.5, y: 58, lx: 52, ly: 72, libelle: "Ouverture envisagée", statut: "hypothese", focal: true },
            ]}
            legende="Plan illustratif, non à l'échelle. Exemple de ce que DVK Expérience établit pour chaque bien."
          />
        )}
      </div>
    </div>
    <ul class="points" aria-label="Comment DVK Studio travaille">
      <li><strong>Un seul interlocuteur</strong>Chef de projet travaux hemea : cadrage, budget, consultation d'entreprises.</li>
      <li><strong>Des chiffres qui disent ce qu'ils sont</strong>Réel, estimation, hypothèse ou à chiffrer.</li>
      <li><strong>Vingt minutes pour commencer</strong>Par téléphone, sans engagement.</li>
    </ul>
  </section>

  <!-- 2 · Où en êtes-vous ? Trois entrées, pas de cartes -->
  <section class="section conteneur" id="situations" aria-labelledby="titre-situations">
    <p class="surtitre">Pour qui</p>
    <h2 id="titre-situations" class="titre-l titre-court">Où en êtes-vous ?</h2>
    <nav class="entrees" aria-label="Votre situation">
      {situations.map((s, i) => (
        <a href={s.href} class="entree">
          <span class="numero">{String(i + 1).padStart(2, "0")}</span>
          <span class="entree-titre">{s.titre}</span>
          <span class="entree-texte">{s.texte}</span>
          <span class="entree-lien">{s.lien}</span>
        </a>
      ))}
    </nav>
  </section>

  <!-- 3 · DVK Expérience : ce que reçoit le client -->
  <section id="experience" class="sombre section" aria-labelledby="titre-experience">
    <div class="conteneur demo-grille">
      <div>
        <p class="surtitre">DVK Expérience</p>
        <h2 id="titre-experience" class="titre-l titre-court">Une page claire pour chaque bien.</h2>
        <ul class="demo-liste">
          <li><strong>Le bien tel qu'il est</strong>, avec la source de chaque donnée.</li>
          <li><strong>Deux pistes comparées</strong> à vos besoins, pas seulement des travaux.</li>
          <li><strong>Un budget honnête</strong> : « à chiffrer » plutôt qu'un chiffre inventé.</li>
        </ul>
        <div class="hero-actions">
          <BoutonRdv bouton="experience.rdv" parcours="experience">Je veux la même pour mon bien</BoutonRdv>
          <a class="btn btn-contour demo-lien" href="/experience/">Découvrir DVK Expérience</a>
        </div>
      </div>
      <div class="demo-fenetre">
        {experience ? (
          <a class="apercu" href={`/experience/${experience.slug}/`}>
            <span class="dvk-availability is-demo">Projet pilote</span>
            <strong>{experience.titre}</strong>
            <span class="accroche">{experience.accroche}</span>
            <span class="aller">Découvrir l'expérience →</span>
          </a>
        ) : (
          <>
            <p class="surtitre">Exemple de lecture · démonstration</p>
            <div class="scenarios">
              <div><h3>Scénario A</h3><Statut statut="hypothese" /><p>Comparé à vos besoins, un par un.</p></div>
              <div><h3>Scénario B</h3><Statut statut="hypothese" /><p>Comparé aux mêmes besoins.</p></div>
            </div>
            <p class="budget">Budget : <Statut statut="manquant" libelle="À chiffrer" /> après l'étude. Aucun montant inventé.</p>
            <p class="legende-demo">Exemple de structure, pas un projet réel.</p>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- 4 · Comment ça se passe -->
  <section class="section conteneur" id="methode" aria-labelledby="titre-methode">
    <p class="surtitre">Comment ça se passe</p>
    <h2 id="titre-methode" class="titre-l titre-court">Quatre étapes, un interlocuteur.</h2>
    <div class="methode-etapes">
      <Processus etapes={[
        { titre: "Échange", texte: "Vingt minutes pour comprendre votre situation et votre objectif." },
        { titre: "Visite et relevé", texte: "Le bien est regardé sur place et mesuré." },
        { titre: "Potentiel et budget", texte: "Scénarios et enveloppe indicative, hypothèses à l'appui." },
        { titre: "Décision", texte: "Vous décidez, puis consultation d'entreprises si vous avancez." },
      ]} />
    </div>
    <div class="hero-actions"><BoutonRdv bouton="methode.rdv">Prendre rendez-vous</BoutonRdv></div>
  </section>

  <!-- 5 · Qui vous accompagne (portrait, réalisations et avis : absents tant qu'ils ne sont pas réels et autorisés) -->
  <section class="papier-2 section" id="confiance" aria-labelledby="titre-confiance">
    <div class="conteneur conf">
      <div>
        <p class="surtitre">Qui vous accompagne</p>
        <h2 id="titre-confiance" class="titre-l titre-moyen">Kevin De Vlieger, chef de projet travaux hemea.</h2>
        <p class="chapo conf-texte">Je comprends votre projet, je le cadre et je vous oriente vers les bonnes entreprises. Je ne suis ni architecte ni maître d'œuvre, et les budgets présentés sont des estimations, pas des devis. {iadActive && iad.accueil.confiance} Plus de détails sur la page <a href="/a-propos/">À propos</a>.</p>
      </div>
      <ul class="legende-statuts" aria-label="Ce que veulent dire les statuts">
        <li><Statut statut="reel" /><span>Constaté ou mesuré, avec sa source.</span></li>
        <li><Statut statut="estimation" /><span>Ordre de grandeur, à confirmer après visite.</span></li>
        <li><Statut statut="hypothese" /><span>Lecture de DVK Studio, à vérifier.</span></li>
        <li><Statut statut="manquant" libelle="À chiffrer" /><span>Pas encore établi : rien n'est inventé.</span></li>
      </ul>
    </div>
  </section>

  <!-- 6 · FAQ -->
  <section class="conteneur faq-section" aria-labelledby="titre-faq">
    <h2 id="titre-faq" class="titre-m" style="margin-bottom:32px">Questions fréquentes</h2>
    <Faq questions={faq} />
  </section>

  <!-- 7 · Rendez-vous -->
  <section class="sombre section final" id="rdv" aria-labelledby="titre-rdv">
    <div class="conteneur duo">
      <div>
        <h2 id="titre-rdv" class="titre-l">Parlons de votre projet.</h2>
        <p class="contact"><a href={site.telephoneLien}>{site.telephone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="rdv-carte">
        <p class="titre-m" style="font-size:26px">Choisir un créneau</p>
        <p class="rdv-texte">Vingt minutes, par téléphone, sans engagement. La réservation s'ouvre sur Calendly ; votre origine (page, bouton) est transmise, sans cookie.</p>
        <BoutonRdv bouton="final.rdv">Prendre rendez-vous</BoutonRdv>
      </div>
    </div>
  </section>

  <BarreRdv />
</Base>

<style>
  .hero { padding-top: clamp(24px, 5vw, 56px); padding-bottom: clamp(32px, 5vw, 64px); }
  .hero-grille { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  @media (max-width: 900px) { .hero-grille { grid-template-columns: 1fr; } }
  .hero-texte { display: flex; flex-direction: column; gap: 22px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-top: 8px; }
  .micro { font-size: 14px; color: var(--dvk-text-subtle); margin-top: -8px; }
  .hero-visuel { max-width: 560px; justify-self: center; width: 100%; }
  .points { list-style: none; padding: 0; margin: clamp(32px, 5vw, 56px) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1.5px solid var(--dvk-text); }
  .points li { padding: 16px 20px 4px 0; font-size: 15px; color: var(--dvk-text-muted); }
  .points strong { display: block; font-family: var(--serif); font-weight: 400; font-size: 20px; color: var(--dvk-text); margin-bottom: 2px; }
  @media (max-width: 900px) { .points { grid-template-columns: 1fr; } }

  .titre-court { max-width: 20ch; margin-top: 14px; }
  .titre-moyen { max-width: 22ch; margin-top: 14px; }
  .entrees { margin-top: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 0 40px; border-top: 1.5px solid var(--dvk-text); }
  .entree { padding: 24px 0 28px; display: flex; flex-direction: column; gap: 10px; border-bottom: 1px solid var(--dvk-border); }
  .numero { font-size: 12px; letter-spacing: 0.14em; color: var(--dvk-text-subtle); font-weight: 600; }
  .entree-titre { font-family: var(--serif); font-size: 30px; line-height: 1.1; letter-spacing: -0.01em; }
  .entree-texte { color: var(--dvk-text-muted); font-size: 16px; }
  .entree-lien { color: var(--dvk-action); font-weight: 600; }

  .demo-grille { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  @media (max-width: 900px) { .demo-grille { grid-template-columns: 1fr; } }
  .demo-liste { list-style: none; padding: 0; margin: 28px 0 0; border-top: 1px solid var(--dvk-inverse-subtle); }
  .demo-liste li { padding: 14px 0; border-bottom: 1px solid var(--dvk-inverse-subtle); color: var(--dvk-inverse-muted); }
  .demo-liste strong { color: var(--papier); font-weight: 600; }
  .demo-grille .hero-actions { margin-top: 28px; }
  .demo-lien { color: var(--dvk-background); }
  .demo-fenetre { background: var(--dvk-background); color: var(--dvk-text); border-radius: var(--dvk-radius-md); padding: clamp(18px, 3vw, 32px); }
  .demo-fenetre .surtitre { margin: 0 0 6px; }
  .scenarios { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 12px; }
  .scenarios > div { border-top: 1.5px solid var(--dvk-text); padding-top: 10px; font-size: 15px; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .scenarios h3 { font-size: 22px; font-weight: 400; margin: 0; }
  .scenarios p { margin: 0; color: var(--dvk-text-muted); }
  @media (max-width: 720px) { .scenarios { grid-template-columns: 1fr; } }
  .budget { margin: 16px 0 0; font-size: 15px; color: var(--dvk-text-muted); }
  .legende-demo { margin: 10px 0 0; font-size: 13px; color: var(--dvk-text-subtle); }
  .apercu { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .apercu strong { font-family: var(--serif); font-size: clamp(26px, 3vw, 34px); font-weight: 400; line-height: 1.12; letter-spacing: -0.015em; }
  .accroche { color: var(--dvk-text-muted); font-size: 17px; }
  .aller { color: var(--dvk-action); font-weight: 600; }

  .methode-etapes { margin-top: 36px; }
  .conf { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  @media (max-width: 900px) { .conf { grid-template-columns: 1fr; } }
  .conf-texte { margin-top: 22px; }
  .conf-texte a { text-decoration: underline; text-underline-offset: 3px; }
  .legende-statuts { list-style: none; padding: 0; margin: 0; border-top: 1.5px solid var(--dvk-text); }
  .legende-statuts li { display: grid; grid-template-columns: 130px 1fr; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--dvk-border); align-items: baseline; font-size: 16px; color: var(--dvk-text-muted); }
  @media (max-width: 720px) { .legende-statuts li { grid-template-columns: 1fr; gap: 6px; } }

  .faq-section { max-width: 1000px; padding-block: 96px 40px; }
  .final { margin-top: 96px; }
  .duo { display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: center; justify-content: space-between; }
  .duo > * { flex: 1 1 340px; min-width: 0; }
  .contact { margin-top: 22px; color: var(--brume); }
  .rdv-carte { background: var(--papier); color: var(--encre); border-radius: var(--dvk-radius-md); padding: 28px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .rdv-texte { font-size: 14px; color: var(--pierre); }
</style>
