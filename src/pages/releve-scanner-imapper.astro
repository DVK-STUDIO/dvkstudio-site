---
import Base from "../layouts/Base.astro";
import PremierEchange from "../components/PremierEchange.astro";
import BoutonRdv from "../components/BoutonRdv.astro";
import Processus from "../components/Processus.astro";
import Faq from "../components/Faq.astro";
import { site } from "../content/site";

const titre = "Relevé Laser 2D/3D iMapper Racer 3 | DVK Studio";
const description = "Relevés d'état des lieux par scanner laser iMapper Racer 3 dans l'Oise et la Somme. Plans cotés 2D/3D (DWG, DXF, PDF) livrés sous 48h à 72h.";

const faq = [
  {
    q: "Quelle est la précision du scanner iMapper Racer 3 ?",
    r: "Le scanner iMapper Racer 3 offre une précision millimétrique de ±2 mm pour une portée de 30 mètres en intérieur. Il capture 1 200 points par minute à 360°, éliminant toute incertitude de métré."
  },
  {
    q: "Quels formats de fichiers me livrez-vous ?",
    r: "Vous recevez les fichiers sources vectoriels natifs .DWG et .DXF (compatibles AutoCAD, ArchiCAD, SketchUp, Revit), ainsi que des planches PDF cotées à l'échelle et, sur demande, les nuages de points ou volumes IFC."
  },
  {
    q: "Combien de temps dure l'intervention sur place ?",
    r: "Grâce à la rapidité du balayage laser (environ 2 minutes par station), une maison de 150 m² est entièrement numérisée en 45 minutes à 1 h 30, sans perturber les occupants."
  },
  {
    q: "Intervenez-vous pour les particuliers ou uniquement les professionnels ?",
    r: "J'interviens pour les deux : pour les architectes, décorateurs et marchands de biens qui souhaitent déléguer leurs relevés, et pour les particuliers qui préparent des travaux, un permis de construire ou une déclaration préalable."
  },
  {
    q: "Quelle est votre zone géographique d'intervention ?",
    r: "J'interviens sur l'ensemble des départements de l'Oise (60) et de la Somme (80) dans leur intégralité : Beauvais, Compiègne, Chantilly, Senlis, Creil, Clermont, Amiens, Abbeville, Montdidier, etc."
  },
  {
    q: "Quels sont vos tarifs pour un relevé laser et plans 2D/3D ?",
    r: "Les tarifs démarrent à un forfait fixe de 300 € HT (moins de 60 m²), puis sont dégressifs selon la surface (450 € à 580 € HT pour 60 à 120 m²). De plus, le relevé est intégralement déduit du chantier si les travaux sont réalisés avec le cadre hemea via DVK Studio."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Relevé d'état des lieux par scanner laser iMapper Racer 3",
  "provider": {
    "@type": "Person",
    "name": "Kévin DE VLIEGER",
    "jobTitle": "Chef de projet travaux hemea",
    "telephone": "+33640324752",
    "email": "contact@dvkstudio.fr"
  },
  "areaServed": ["Oise", "Somme"],
  "description": description
};
---

<Base titre={titre} description={description} page="releve-scanner-imapper" chemin="/releve-scanner-imapper/" donneesStructurees={schema}>
  <!-- Hero Section -->
  <header class="conteneur page-hero" style="padding-top: 56px; padding-bottom: 48px;">
    <p class="surtitre">Relevé Laser & Plans 2D/3D · Oise (60) & Somme (80)</p>
    <h1 class="titre-xl" style="margin-top: 14px; margin-bottom: 20px;">
      Vos plans d'état des lieux cotés au millimètre.<br />Grâce au scanner laser iMapper Racer 3.
    </h1>
    <p class="chapo" style="max-width: 68ch;">
      Numérisation 360° rapide, détection immédiate des faux-équerrages et livraison sous 48 h à 72 h de vos plans vectoriels (DWG, DXF, PDF). Gagnez du temps et sécurisez votre projet de rénovation dès le départ.
    </p>
    <div class="actions" style="margin-top: 28px;">
      <BoutonRdv bouton="hero.releve" parcours="pro">Planifier un relevé ou un échange de 30 min</BoutonRdv>
      <a class="lien-souligne" href="#tarifs">Consulter les tarifs</a>
      <a class="lien-souligne" href="#livrables">Découvrir les livrables</a>
    </div>
  </header>

  <!-- Section 1 : Pourquoi le Racer 3 change tout -->
  <section class="section conteneur" aria-labelledby="t-racer3">
    <p class="surtitre">Technologie & Précision</p>
    <h2 id="t-racer3" class="titre-l">La fin du mètre ruban et des cotes approximatives.</h2>
    <p class="chapo">
      Dans les bâtisses anciennes de Picardie, les murs droits n'existent pas. Le scanner laser iMapper Racer 3 capture la réalité brute du lieu sans extrapolation.
    </p>
    <div class="bloc" style="margin-top: 32px;">
      <div>
        <h3>Précision de ±2 mm</h3>
        <p>Un faisceau laser haute fréquence capture 1 200 points par minute avec une portée de 30 mètres pour figer chaque angle et chaque irrégularité.</p>
      </div>
      <div>
        <h3>2 minutes par pièce</h3>
        <p>L'appareil balaye l'espace en rotation continue et capture automatiquement des photos de repérage grand angle à 360°.</p>
      </div>
      <div>
        <h3>Coupes verticales à 90°</h3>
        <p>Bascule instantanée pour mesurer les hauteurs sous plafond, les allèges, les poutres et les cages d'escalier complexes au millimètre.</p>
      </div>
      <div>
        <h3>Zéro oubli sur site</h3>
        <p>L'intégralité du volume est numérisée en une seule visite. Aucun besoin de retourner sur site pour reprendre une cote manquante.</p>
      </div>
    </div>
  </section>

  <!-- Section 2 : Parcours Cibles -->
  <section class="papier-2 section" aria-labelledby="t-cibles">
    <div class="conteneur">
      <p class="surtitre">Deux approches adaptées</p>
      <h2 id="t-cibles" class="titre-l" style="margin-top: 14px;">Une réponse sur-mesure pour chaque besoin.</h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; margin-top: 36px;">
        <div style="background: var(--dvk-surface); border: 1px solid var(--dvk-border); border-radius: var(--dvk-radius-md); padding: 32px; box-shadow: var(--dvk-shadow-card);">
          <span class="surtitre" style="color: var(--dvk-action);">Pour les professionnels</span>
          <h3 style="font-size: 22px; margin-top: 12px; margin-bottom: 16px;">Architectes, Décorateurs & MDB</h3>
          <ul style="padding-left: 20px; line-height: 1.8; color: var(--dvk-text-muted); font-size: 15px;">
            <li><strong>Déléguez le métré</strong> : Épargnez-vous des heures de relevé fastidieux sur le terrain.</li>
            <li><strong>Fichiers sources prêts à dessiner</strong> : Intégrez directement les calques DWG/DXF dans AutoCAD, ArchiCAD ou SketchUp.</li>
            <li><strong>Réactivité locale</strong> : Intervention rapide dans le 60 et le 80 pour lancer vos phases d'esquisse sans retard.</li>
          </ul>
        </div>

        <div style="background: var(--dvk-surface); border: 1px solid var(--dvk-border); border-radius: var(--dvk-radius-md); padding: 32px; box-shadow: var(--dvk-shadow-card);">
          <span class="surtitre" style="color: var(--dvk-action);">Pour les particuliers</span>
          <h3 style="font-size: 22px; margin-top: 12px; margin-bottom: 16px;">Particuliers & Investisseurs</h3>
          <ul style="padding-left: 20px; line-height: 1.8; color: var(--dvk-text-muted); font-size: 15px;">
            <li><strong>Dossiers administratifs</strong> : Plans propres pour vos déclarations préalables (DP) ou permis de construire.</li>
            <li><strong>Sécurisation des surfaces</strong> : Connaissance exacte des surfaces habitables réelles avant achat ou vente.</li>
            <li><strong>Chiffrages artisans fiables</strong> : Des entreprises qui chiffrent sur des bases exactes, sans marge d'incertitude.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3 : Livrables -->
  <section class="section conteneur" id="livrables" aria-labelledby="t-livrables">
    <p class="surtitre">Livrables complets</p>
    <h2 id="t-livrables" class="titre-l">Ce que vous recevez sous 48 h à 72 h.</h2>
    <div class="bloc" style="margin-top: 32px;">
      <div>
        <h3>Plans de niveaux 2D cotés</h3>
        <p>Distributions des pièces, cotes d'ouvertures, épaisseurs de cloisons et surfaces de chaque espace au format PDF haute définition.</p>
      </div>
      <div>
        <h3>Fichiers CAO natifs (DWG / DXF)</h3>
        <p>Fichiers vectorisés propres, calés sur des calques distincts pour être immédiatement exploitables dans vos logiciels de dessin.</p>
      </div>
      <div>
        <h3>Coupes verticales & Altimétrie</h3>
        <p>Repérage des hauteurs sous plafond, des départs de toiture, allèges de fenêtres et décrochés de niveaux.</p>
      </div>
      <div>
        <h3>Photos 360° géolocalisées</h3>
        <p>Association visuelle de chaque point mesuré à sa photo de repérage pour vérifier un détail technique à distance.</p>
      </div>
    </div>
  </section>

  <!-- Section 4 : Tableau comparatif -->
  <section class="papier-2 section" aria-labelledby="t-comparatif">
    <div class="conteneur">
      <p class="surtitre">Comparatif de performance</p>
      <h2 id="t-comparatif" class="titre-l">Pourquoi abandonner la méthode traditionnelle ?</h2>
      <div style="overflow-x: auto; margin-top: 32px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; background: var(--dvk-surface); border-radius: var(--dvk-radius-md); overflow: hidden; border: 1px solid var(--dvk-border);">
          <thead>
            <tr style="background: var(--dvk-surface-raised); border-bottom: 2px solid var(--dvk-border);">
              <th style="padding: 16px 20px; font-weight: 600;">Critère</th>
              <th style="padding: 16px 20px; font-weight: 600;">Mètre ruban classique</th>
              <th style="padding: 16px 20px; font-weight: 600; color: var(--dvk-action);">Scanner iMapper Racer 3</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--dvk-border);">
              <td style="padding: 14px 20px; font-weight: 600;">Temps sur place</td>
              <td style="padding: 14px 20px;">3 h à 5 h (souvent en binôme)</td>
              <td style="padding: 14px 20px; font-weight: 600;">45 min à 1 h 30 (autonome)</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--dvk-border);">
              <td style="padding: 14px 20px; font-weight: 600;">Précision</td>
              <td style="padding: 14px 20px;">Aléatoire, dérive cumulative</td>
              <td style="padding: 14px 20px; font-weight: 600;">±2 mm, faisceau 360°</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--dvk-border);">
              <td style="padding: 14px 20px; font-weight: 600;">Faux-équerrages</td>
              <td style="padding: 14px 20px;">Invisibles à l'œil nu</td>
              <td style="padding: 14px 20px; font-weight: 600;">Détectés et cotés au millimètre</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--dvk-border);">
              <td style="padding: 14px 20px; font-weight: 600;">Livrables</td>
              <td style="padding: 14px 20px;">Croquis papier à redessiner</td>
              <td style="padding: 14px 20px; font-weight: 600;">Fichiers CAO prêts (DWG / DXF / PDF)</td>
            </tr>
            <tr>
              <td style="padding: 14px 20px; font-weight: 600;">Risque d'oubli</td>
              <td style="padding: 14px 20px;">Fréquent (retour sur site nécessaire)</td>
              <td style="padding: 14px 20px; font-weight: 600;">Nul (empreinte globale figée)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Section 5 : Tarifs & Formules -->
  <section class="section conteneur" id="tarifs" aria-labelledby="t-tarifs">
    <p class="surtitre">Tarifs clairs & sans surprise</p>
    <h2 id="t-tarifs" class="titre-l">Une grille transparente adaptée à chaque projet.</h2>
    <p class="chapo">
      Déplacement inclus dans l'Oise (60) et la Somme (80). Livrables complets livrés sous 48 h à 72 h.
    </p>

    <!-- Grille des surfaces -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; margin-top: 36px;">
      <div style="background: var(--dvk-surface); border: 1px solid var(--dvk-border); border-radius: var(--dvk-radius-md); padding: 28px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--dvk-text-muted);">Forfait Studio / T2</span>
          <h3 style="font-size: 22px; margin-top: 8px; margin-bottom: 12px;">Moins de 60 m²</h3>
          <p style="font-size: 30px; font-weight: 600; color: var(--dvk-action); margin-bottom: 12px;">300 € <span style="font-size: 15px; font-weight: 500; color: var(--dvk-text-muted);">HT</span></p>
          <p style="font-size: 14px; color: var(--dvk-text-muted); line-height: 1.6;">Forfait plancher d'intervention. Idéal pour studio, T2, local commercial ou division de lots.</p>
        </div>
        <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--dvk-border); font-size: 13px; color: var(--dvk-text-muted);">
          ✓ Plans 2D DWG, DXF & PDF inclus
        </div>
      </div>

      <div style="background: var(--dvk-surface); border: 2px solid var(--dvk-accent); border-radius: var(--dvk-radius-md); padding: 28px; position: relative; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--dvk-shadow-card);">
        <span style="position: absolute; top: -12px; right: 20px; background: var(--dvk-accent); color: #ffffff; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 12px; border-radius: var(--dvk-radius-pill);">Le plus fréquent</span>
        <div>
          <span style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--dvk-action);">Maison & Appartement</span>
          <h3 style="font-size: 22px; margin-top: 8px; margin-bottom: 12px;">60 à 120 m²</h3>
          <p style="font-size: 30px; font-weight: 600; color: var(--dvk-action); margin-bottom: 12px;">450 € à 580 € <span style="font-size: 15px; font-weight: 500; color: var(--dvk-text-muted);">HT</span></p>
          <p style="font-size: 14px; color: var(--dvk-text-muted); line-height: 1.6;">Tarif dégressif (~4,70 € / m²). Parfait pour appartement familial, maison de ville ou pavillon.</p>
        </div>
        <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--dvk-border); font-size: 13px; color: var(--dvk-text-muted);">
          ✓ Plans 2D DWG, DXF & PDF inclus
        </div>
      </div>

      <div style="background: var(--dvk-surface); border: 1px solid var(--dvk-border); border-radius: var(--dvk-radius-md); padding: 28px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--dvk-text-muted);">Maison de caractère</span>
          <h3 style="font-size: 22px; margin-top: 8px; margin-bottom: 12px;">120 à 200 m²</h3>
          <p style="font-size: 30px; font-weight: 600; color: var(--dvk-action); margin-bottom: 12px;">680 € à 850 € <span style="font-size: 15px; font-weight: 500; color: var(--dvk-text-muted);">HT</span></p>
          <p style="font-size: 14px; color: var(--dvk-text-muted); line-height: 1.6;">Tarif dégressif (~4,20 € / m²). Bâtisses anciennes, longères picardes, combles aménagés.</p>
        </div>
        <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--dvk-border); font-size: 13px; color: var(--dvk-text-muted);">
          ✓ Plans 2D DWG, DXF & PDF inclus
        </div>
      </div>

      <div style="background: var(--dvk-surface); border: 1px solid var(--dvk-border); border-radius: var(--dvk-radius-md); padding: 28px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--dvk-text-muted);">Grandes surfaces</span>
          <h3 style="font-size: 22px; margin-top: 8px; margin-bottom: 12px;">Plus de 200 m²</h3>
          <p style="font-size: 30px; font-weight: 600; color: var(--dvk-action); margin-bottom: 12px;">Sur devis</p>
          <p style="font-size: 14px; color: var(--dvk-text-muted); line-height: 1.6;">Tarif dégressif dès 3,50 € / m². Immeubles de rapport, corps de ferme, bâtiments industriels.</p>
        </div>
        <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--dvk-border); font-size: 13px; color: var(--dvk-text-muted);">
          ✓ Étude personnalisée sous 24 h
        </div>
      </div>
    </div>

    <!-- Options complémentaires -->
    <div style="background: var(--dvk-surface-raised); border: 1px solid var(--dvk-border); border-radius: var(--dvk-radius-md); padding: 28px; margin-top: 32px;">
      <h3 style="font-size: 18px; margin-bottom: 16px;">Options complémentaires à la carte</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        <div style="padding: 18px; background: var(--dvk-surface); border-radius: var(--dvk-radius-sm); border: 1px solid var(--dvk-border);">
          <strong style="color: var(--dvk-text); font-size: 15px;">Option Coupes & Façades : +150 € HT</strong>
          <p style="font-size: 13.5px; color: var(--dvk-text-muted); margin-top: 6px; line-height: 1.5; margin-bottom: 0;">2 coupes altimétriques indispensables pour toitures/escaliers + élévation des façades.</p>
        </div>
        <div style="padding: 18px; background: var(--dvk-surface); border-radius: var(--dvk-radius-sm); border: 1px solid var(--dvk-border);">
          <strong style="color: var(--dvk-text); font-size: 15px;">Option Modélisation 3D : +250 € à 350 € HT</strong>
          <p style="font-size: 13.5px; color: var(--dvk-text-muted); margin-top: 6px; line-height: 1.5; margin-bottom: 0;">Maquette volumique 3D prête pour SketchUp ou fichier IFC (BIM) selon la surface.</p>
        </div>
      </div>
    </div>

    <!-- Les 2 engagements DVK Studio -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 32px;">
      <div style="background: var(--dvk-action-soft); border: 1px solid var(--dvk-accent); border-radius: var(--dvk-radius-md); padding: 24px;">
        <span style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--dvk-action-deep);">Avantage Particuliers & Investisseurs</span>
        <h4 style="font-size: 17px; margin-top: 8px; margin-bottom: 8px; color: var(--dvk-text);">Relevé 100 % déduit de vos travaux</h4>
        <p style="font-size: 13.5px; color: var(--dvk-text); line-height: 1.6; margin: 0;">
          Si vous confiez la réalisation de votre rénovation aux artisans audités hemea via DVK Studio, le montant du relevé est intégralement déduit de votre projet.
        </p>
      </div>

      <div style="background: var(--dvk-surface); border: 1px solid var(--dvk-border-strong); border-radius: var(--dvk-radius-md); padding: 24px;">
        <span style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--dvk-primary);">Avantage Partenaires Professionnels</span>
        <h4 style="font-size: 17px; margin-top: 8px; margin-bottom: 8px; color: var(--dvk-text);">Forfait récurrent : -15 % dès le 2ᵉ relevé</h4>
        <p style="font-size: 13.5px; color: var(--dvk-text-muted); line-height: 1.6; margin: 0;">
          Pour les architectes, décorateurs et marchands de biens de l'Oise et de la Somme confiant régulièrement leurs métrés à DVK Studio.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 6 : FAQ & Contact -->
  <section class="section conteneur" aria-labelledby="t-faq">
    <h2 id="t-faq" class="titre-m" style="margin-bottom: 32px;">Questions fréquentes sur le relevé scanner laser</h2>
    <Faq questions={faq} />
    <div class="actions" style="margin-top: 36px;">
      <BoutonRdv bouton="faq.releve" parcours="pro">Réserver mon créneau ou demander un devis</BoutonRdv>
    </div>
  </section>

  <PremierEchange pro />
</Base>
