---
import PremierEchange from "../components/PremierEchange.astro";
import Base from "../layouts/Base.astro";
import BoutonRdv from "../components/BoutonRdv.astro";
import Processus from "../components/Processus.astro";
import Faq from "../components/Faq.astro";
import { site } from "../content/site";
import MatiereChantier from "../components/MatiereChantier.astro";
import { chantier } from "../lib/medias";

// Matière chantier (mur ouvert, structure, isolation) : une seule grande image, avec sa provenance. Absente tant que ses droits ne sont pas confirmés.
const matiere = chantier();

const faq = [
  { q: "Dois-je déjà avoir des plans ou des devis ?", r: "Non. Pour commencer, la commune du bien, une description du besoin et votre calendrier suffisent. Les informations à approfondir sont précisées pendant l’échange." },
  { q: "Comment connaître le coût de l’accompagnement ?", r: "Le périmètre et les modalités sont précisés selon votre projet avant toute prestation. Le premier échange ne vous engage pas pour la suite." },
  { q: "Êtes-vous maître d'œuvre ?", r: "Non. DVK Studio n'est ni maître d'œuvre, ni architecte, ni bureau d'études, et ne réalise pas de travaux. Je cadre votre projet, estime son budget et vous aide à consulter des entreprises labellisées hemea." },
  { q: "Garantissez-vous les entreprises et leurs travaux ?", r: "Non. Les devis et les travaux relèvent des entreprises consultées. DVK Studio ne garantit personnellement ni leurs prix ni leurs travaux." },
  { q: "Le budget présenté est-il un devis ?", r: "Non. C'est une estimation indicative, non contractuelle, avec ses hypothèses et ses limites. Un devis est établi par les entreprises consultées." },
  { q: "Que se passe-t-il si mon projet touche à la structure ?", r: "Il faut alors une étude préalable avant toute décision. Elle est signalée comme telle dans l'étude : aucun budget n'est avancé tant qu'elle n'a pas eu lieu." },
];
---

<Base
  titre="Particuliers : préparer vos travaux avec hemea | Oise et Somme"
  description="Kevin De Vlieger, chef de projet travaux hemea dans l’Oise et la Somme : cadrage de votre rénovation, budget indicatif et consultation d’entreprises."
  page="travaux"
  chemin="/travaux/"
>
  <header class="conteneur page-hero">
    <p class="surtitre">Travaux · {site.zone}</p>
    <h1 class="titre-xl">Votre rénovation commence par un projet clair.</h1>
    <p class="chapo">Vous avez des idées, mais vous hésitez sur les travaux à prévoir, le budget ou les entreprises à consulter ? Kevin De Vlieger, chef de projet travaux hemea dans l’Oise et la Somme, vous aide à préparer les prochaines étapes.</p>
    <div class="actions"><BoutonRdv bouton="hero.rdv" parcours="renover">Faire le point sur mon projet</BoutonRdv></div>
  </header>

  {matiere && (
    <section class="conteneur" aria-label="Matière chantier">
      <MatiereChantier src={matiere.src} alt={matiere.alt} provenance={matiere.provenance} standin={matiere.standin} />
    </section>
  )}

  <section class="section conteneur" aria-labelledby="t-probleme">
    <h2 id="t-probleme" class="titre-l" style="max-width:22ch">Ce que vous y gagnez.</h2>
    <div class="bloc">
      <div><h3>Le problème</h3><p>Des idées, mais pas de plan. Des devis difficiles à comparer. Un budget qui dérape parce que les contraintes du bien n'ont pas été vues au départ.</p></div>
      <div><h3>Ce que fait DVK Studio</h3><p>Cadrage des besoins, pistes de travaux, enveloppe indicative avec ses hypothèses, puis consultation d'entreprises labellisées hemea et accompagnement du projet en tant que chef de projet travaux hemea.</p></div>
      <div><h3>Pour vous, concrètement</h3><p>Des priorités explicites, une enveloppe dont les hypothèses sont expliquées et les prochaines étapes définies selon le périmètre convenu.</p></div>
    </div>
  </section>

  <section class="papier-2 section" aria-labelledby="t-demarche">
    <div class="conteneur">
      <h2 id="t-demarche" class="titre-l" style="max-width:22ch">Une démarche en quatre temps.</h2>
      <div style="margin-top:40px">
        <Processus variant="liste" etapes={[
          { titre: "Échange", texte: "Trente minutes pour comprendre votre situation et votre objectif." },
          { titre: "Étude du besoin", texte: "Les informations sur le bien et les vérifications nécessaires sont précisées selon le projet." },
          { titre: "Scénarios et enveloppe", texte: "Plusieurs pistes comparées, chacune avec ce qu'elle apporte et ce qu'elle laisse de côté." },
          { titre: "Consultation et suite", texte: "Consultation d'entreprises labellisées hemea et accompagnement si vous décidez d'avancer." },
        ]} />
      </div>
      <div class="actions"><BoutonRdv bouton="demarche.rdv" parcours="renover">Faire le point sur mon projet</BoutonRdv></div>
    </div>
  </section>

  <section class="section conteneur" aria-labelledby="t-faq">
    <h2 id="t-faq" class="titre-m" style="margin-bottom:32px">Questions fréquentes</h2>
    <Faq questions={faq} />
  </section>
  <PremierEchange />
</Base>

