---
import Base from "../layouts/Base.astro";
import BoutonRdv from "../components/BoutonRdv.astro";
import Processus from "../components/Processus.astro";
import Faq from "../components/Faq.astro";
import { site } from "../content/site";
import { faqAcquereurConseil } from "../content/immobilier";
import PhotoAnnotee from "../components/PhotoAnnotee.astro";
import { imageAcquereurs } from "../lib/medias";

// Bien existant + lecture du potentiel et travaux à anticiper. Absent tant que ses droits ne sont pas confirmés : hero actuel.
const photo = imageAcquereurs();

const faq = [
  { q: "Je veux louer le bien : est-ce aussi pour moi ?", r: "Oui. Que vous achetiez pour l'habiter ou pour le louer, la question des travaux est la même : que peut devenir ce bien, et quelle enveloppe de travaux faut-il envisager ?" },
  { q: "Le budget présenté est-il un devis ?", r: "Non. C'est une estimation indicative, avec ses hypothèses et ses limites. Ce qui n'est pas encore établi est indiqué « à chiffrer » : aucun montant n'est inventé." },
  { q: "Donnez-vous un avis sur l'opportunité d'acheter ?", r: faqAcquereurConseil },
  { q: "Le premier échange m'engage-t-il ?", r: "Non. C'est un échange de vingt minutes par téléphone, sans engagement." },
];
---

<Base
  titre="Acquéreurs : acheter un bien à rénover en connaissant ses travaux"
  description="Acheter un bien à rénover en Oise avec DVK Studio : pistes de travaux et enveloppe de travaux indicative pour cadrer votre projet avant d'acheter."
  page="acquereurs"
  chemin="/acquereurs/"
>
  {photo ? (
  <header class="conteneur page-hero hero-media">
    <div class="hm-tete">
      <p class="surtitre">Acquéreurs · {site.zone}</p>
      <h1 class="titre-xl">Acheter un bien à rénover, en sachant ce qu'il peut devenir.</h1>
    </div>
    <div class="hm-visuel">
      <PhotoAnnotee src={photo.src} alt={photo.alt} reperes={photo.reperes} standin={photo.standin} cotes={["01 · Le bien", "Potentiel · 02"]} />
    </div>
    <div class="hm-corps">
      <p class="chapo">On visite un bien daté sans savoir ce qu'on peut en faire, ni combien cela coûterait. DVK Studio vous aide à voir clair avant de signer, que vous achetiez pour l'habiter ou pour le louer.</p>
      <div class="actions"><BoutonRdv bouton="hero.rdv" parcours="acheter">Analyser un bien avant d'acheter</BoutonRdv></div>
    </div>
  </header>
  ) : (
    <header class="conteneur page-hero">
      <p class="surtitre">Acquéreurs · {site.zone}</p>
      <h1 class="titre-xl">Acheter un bien à rénover, en sachant ce qu'il peut devenir.</h1>
      <p class="chapo">On visite un bien daté sans savoir ce qu'on peut en faire, ni combien cela coûterait. DVK Studio vous aide à voir clair avant de signer, que vous achetiez pour l'habiter ou pour le louer.</p>
      <div class="actions"><BoutonRdv bouton="hero.rdv" parcours="acheter">Analyser un bien avant d'acheter</BoutonRdv></div>
    </header>
  )}

  <section class="section conteneur" aria-labelledby="t-valeur">
    <h2 id="t-valeur" class="titre-l" style="max-width:22ch">Ce bien me plaît, mais je n'arrive pas à me projeter.</h2>
    <div class="bloc">
      <div><h3>Le problème</h3><p>Le potentiel d'un bien est difficile à lire en visite, le coût des travaux reste flou, et le projet global, prix d'achat plus travaux, n'est pas suffisamment cadré avant de vous engager dans votre projet.</p></div>
      <div><h3>Ce que fait DVK Studio</h3><p>Des pistes de travaux et d'aménagement, présentées comme telles et comparées à vos besoins, et une enveloppe de travaux indicative : un outil de projection et de cadrage, pas une étude de faisabilité.</p></div>
      <div><h3>Pour vous, concrètement</h3><p>Une vision plus claire des travaux à envisager avant de poursuivre votre projet d'acquisition, et un interlocuteur qui peut ensuite cadrer les travaux et consulter des entreprises labellisées hemea.</p></div>
    </div>
  </section>

  <section class="papier-2 section" aria-labelledby="t-methode">
    <div class="conteneur">
      <h2 id="t-methode" class="titre-l" style="max-width:20ch">Avant de signer, quatre étapes.</h2>
      <div style="margin-top:40px">
        <Processus etapes={[
          { titre: "Échange", texte: "Vingt minutes pour comprendre votre projet et votre budget." },
          { titre: "Visite et relevé", texte: "Le bien est regardé sur place et mesuré." },
          { titre: "Potentiel et budget", texte: "Scénarios et enveloppe indicative, hypothèses à l'appui." },
          { titre: "Décision", texte: "Vous disposez des éléments liés aux travaux pour décider de poursuivre ou non votre projet d'acquisition." },
        ]} />
      </div>
    </div>
  </section>

  <section class="section conteneur" aria-labelledby="t-faq">
    <h2 id="t-faq" class="titre-m" style="margin-bottom:32px">Questions fréquentes</h2>
    <Faq questions={faq} />
    <div class="actions"><BoutonRdv bouton="faq.rdv" parcours="acheter">Prendre rendez-vous</BoutonRdv></div>
  </section>
</Base>
