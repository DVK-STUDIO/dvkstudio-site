<script>
  // Étape courante dans la barre de chapitres (amélioration : la page fonctionne sans).
  const liens = Array.from(document.querySelectorAll<HTMLAnchorElement>(".chapitres a"));
  const sections = liens.map((a) => document.getElementById(a.dataset.chap ?? "")).filter((s): s is HTMLElement => !!s);
  if ("IntersectionObserver" in window && sections.length) {
    const io = new IntersectionObserver(
      (entrees) => {
        for (const en of entrees) {
          if (!en.isIntersecting) continue;
          liens.forEach((a) => a.removeAttribute("aria-current"));
          const a = liens.find((l) => l.dataset.chap === en.target.id);
          a?.setAttribute("aria-current", "true");
          const liste = a?.closest("ol");
          if (a && liste) liste.scrollTo({ left: a.offsetLeft - liste.clientWidth / 2 + a.clientWidth / 2, behavior: "smooth" });
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
