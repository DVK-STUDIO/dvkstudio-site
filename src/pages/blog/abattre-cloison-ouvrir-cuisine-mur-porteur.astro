const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Ouvrir sa cuisine sur le salon : ce qu'il faut vérifier avant d'abattre une cloison",
  "author": {
    "@type": "Person",
    "name": "Kévin DE VLIEGER",
    "jobTitle": "Chef de projet travaux hemea",
    "telephone": "+33640324752",
    "email": "contact@dvkstudio.fr",
    "url": "https://dvkstudio.fr/a-propos/"
  },
  "publisher": {
    "@type": "Organization",
