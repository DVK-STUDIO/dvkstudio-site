---
import Base from "../layouts/Base.astro";
---

<Base titre="Page introuvable" description="Cette page n'existe pas ou a été déplacée." page="404" chemin="/404/" noindex>
  <div class="conteneur page-hero">
    <p class="surtitre">Erreur 404</p>
    <h1 class="titre-xl">Cette page n'existe pas.</h1>
    <p class="chapo">Elle a peut-être été déplacée lors de la refonte du site. Reprenez depuis l'accueil.</p>
    <div class="actions"><a class="btn btn-encre" href="/">Retour à l'accueil</a></div>
  </div>
</Base>
