---
import Base from "../layouts/Base.astro";
import { site } from "../content/site";
import { iadActive } from "../content/capacites";
import { iad } from "../content/iad";
import MentionsReglementaires from "../iad/MentionsReglementaires.astro";
const e = site.editeur;
---

<Base titre="Mentions légales" description={iadActive ? iad.mentions.description : "Mentions légales du site dvkstudio.fr : éditeur, accompagnement des travaux, hébergeur."} page="mentions-legales" chemin="/mentions-legales/">
  <div class="conteneur page-hero prose">
    <p class="surtitre">Légal</p>
    <h1 class="titre-xl">Mentions légales</h1>
    <p>Version préparée le 3 octobre 2026 ; en vigueur à la mise en ligne du site.</p>

    <h2>Éditeur du site</h2>
    <p>{site.nom} est le nom commercial de l'entreprise individuelle de {e.nom}, assujettie à la TVA.</p>
    <ul>
      <li>Forme : {e.forme} — {e.nom}</li>
      <li>Adresse : {e.adresse}</li>
      <li>SIRET : {e.siret} — SIREN : {e.siren}</li>
      <li>Code APE : {e.ape}</li>
      <li>Début d'activité : {e.debutActivite}</li>
      <li>N° de TVA intracommunautaire : {e.tva}</li>
      <li>Téléphone : {site.telephone} — Email : {site.email}</li>
    </ul>

  {iadActive && <MentionsReglementaires />}

    <h2>Accompagnement des travaux</h2>
    <p>{e.nom} exerce, sous le nom commercial {site.nom}, comme chef de projet travaux hemea et mandataire indépendant de la société {site.mandant.denomination}, exploitant sous l'enseigne {site.mandant.enseigne}. Pour cette activité, {e.nom} agit au nom et pour le compte de cette société, en toute indépendance.</p>
    <ul>
      <li>Mandant : {site.mandant.denomination}, {site.mandant.forme}, {site.mandant.rcs}, siège social : {site.mandant.siege}.</li>
      <li>{site.nom} est le nom commercial de l'entreprise individuelle de {e.nom} : ce n'est pas {site.mandant.enseigne}, ni une société du réseau {site.mandant.enseigne}.</li>
      <li>{e.nom} n'encaisse aucune somme liée aux travaux.</li>
    </ul>
    <p>{site.nom} n'intervient pas comme architecte, maître d'œuvre, assistant à maîtrise d'ouvrage, bureau d'études, conseiller financier ou conseiller en investissement immobilier, et ne réalise pas de travaux.</p>

    <h2>Hébergeur</h2>
    <p>GitHub, Inc. — 88 Colin P Kelly Jr Street, San Francisco, CA 94107, États-Unis. Site hébergé sur GitHub Pages.</p>

    <h2>Directeur de la publication</h2>
    <p>{e.nom} — <a href={`mailto:${site.email}`}>{site.email}</a></p>

    <h2>Propriété intellectuelle</h2>
    <p>L'ensemble des contenus de ce site est la propriété exclusive de {site.nom}, sauf mention contraire. Toute reproduction sans accord écrit préalable est interdite.</p>

    <h2>Limitation de responsabilité</h2>
    <p>Les informations publiées sont données à titre indicatif. Les budgets présentés sont des estimations indicatives et non contractuelles, et ne constituent pas des devis : les devis sont établis par les entreprises consultées. Les plans et schémas présentés sont illustratifs, non à l'échelle.</p>

    <h2>Droit applicable</h2>
    <p>Droit français. Juridiction compétente : tribunal judiciaire d'Amiens.</p>
  </div>
</Base>
