---
// Page /immobilier/ : n'existe dans le build que si la capacité immobilière n'est pas « off » (src/content/capacites.ts).
// Même page dans les deux modes ; seules les variantes de src/content/immobilier.ts changent.
import Base from "../layouts/Base.astro";
import BoutonRdv from "../components/BoutonRdv.astro";
import Processus from "../components/Processus.astro";
import Faq from "../components/Faq.astro";
import Statut from "../components/experience/Statut.astro";
import MentionsReglementaires from "./MentionsReglementaires.astro";
import { mandataireActif } from "../content/capacites";
import { page as p } from "../content/immobilier";

// Données structurées : la FAQ visible, rien d'autre.
const faqStructuree = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: p.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.r } })),
};
---

<Base titre={p.titre} description={p.description} page="immobilier" chemin="/immobilier/" donneesStructurees={faqStructuree}>
  <header class="conteneur page-hero">
    <p class="surtitre">{p.hero.surtitre}</p>
    <h1 class="titre-xl">{p.hero.titre}</h1>
    <p class="chapo">{p.hero.chapo}</p>
    <div class="actions">
      <a class="btn btn-action" href="#vendre">{p.hero.vendre}</a>
      <a class="btn btn-contour" href="#acheter">{p.hero.acheter}</a>
    </div>
    <p class="micro">{p.hero.ligne}</p>
  </header>

  <section class="section conteneur" aria-labelledby="t-approche">
    <p class="surtitre">{p.approche.surtitre}</p>
    <h2 id="t-approche" class="titre-l titre-court">{p.approche.titre}</h2>
    <div class="bloc">
      {p.approche.blocs.map((b) => <div><h3>{b.titre}</h3><p>{b.texte}</p></div>)}
    </div>
    <div class="chaine"><Processus etapes={p.approche.chaine} /></div>
  </section>

  <section id="experience" class="sombre section" aria-labelledby="t-experience">
    <div class="conteneur demo-grille">
      <div>
        <p class="surtitre">{p.experience.surtitre}</p>
        <h2 id="t-experience" class="titre-l titre-court">{p.experience.titre}</h2>
        <p class="chapo">{p.experience.intro}</p>
        <ul class="demo-liste">
          {p.experience.points.map((t) => <li>{t}</li>)}
        </ul>
        <p class="demo-note">{p.experience.limites}</p>
        <div class="actions"><a class="btn btn-action" href="/experience/">{p.experience.cta}</a></div>
      </div>
      <div class="demo-fenetre">
        <p class="surtitre">{p.experience.legendeTitre}</p>
        <ul class="legende-statuts">
          {p.experience.legende.map((l) => <li><Statut statut={l.statut} libelle={"libelle" in l ? l.libelle : undefined} /><span>{l.texte}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="vendre" class="section conteneur" aria-labelledby="t-vendre">
    <p class="surtitre">{p.vendre.surtitre}</p>
    <h2 id="t-vendre" class="titre-l titre-long">{p.vendre.titre}</h2>
    <p class="chapo chapo-section">{p.vendre.chapo}</p>
    <div class="etapes etapes-5"><Processus etapes={p.vendre.etapes} /></div>
    <div class="actions"><BoutonRdv bouton="vendre.rdv" parcours="vendre">{p.vendre.cta}</BoutonRdv></div>
  </section>

  <section id="acheter" class="papier-2 section" aria-labelledby="t-acheter">
    <div class="conteneur">
      <p class="surtitre">{p.acheter.surtitre}</p>
      <h2 id="t-acheter" class="titre-l titre-long">{p.acheter.titre}</h2>
      <div class="etapes etapes-6"><Processus etapes={p.acheter.etapes} /></div>
      <p class="zoom"><a href="/acquereurs/">{p.acheter.zoom}</a></p>
      <div class="actions"><BoutonRdv bouton="acheter.rdv" parcours="acheter">{p.acheter.cta}</BoutonRdv></div>
    </div>
  </section>

  <section class="section conteneur" aria-labelledby="t-qui">
    <h2 id="t-qui" class="titre-l titre-long">{p.qui.titre}</h2>
    <div class="bloc">
      {p.qui.colonnes.map((c) => <div><h3>{c.titre}</h3><p>{c.texte}</p></div>)}
    </div>
  </section>

  <section class="conteneur faq-section" aria-labelledby="t-faq">
    <h2 id="t-faq" class="titre-m" style="margin-bottom:32px">Questions fréquentes</h2>
    <Faq questions={p.faq} />
  </section>

  {mandataireActif && (
    <section class="conteneur prose reglementaire" aria-label="Informations réglementaires">
      <MentionsReglementaires />
    </section>
  )}

  <section class="sombre section final" aria-labelledby="t-final">
    <div class="conteneur">
      <h2 id="t-final" class="titre-l">{p.cloture.titre}</h2>
      <div class="actions">
        <BoutonRdv bouton="final.vendre" parcours="vendre">{p.hero.vendre}</BoutonRdv>
        <BoutonRdv bouton="final.acheter" parcours="acheter" classe="btn btn-contour">{p.hero.acheter}</BoutonRdv>
      </div>
    </div>
  </section>
</Base>

<style>
  .micro { font-size: 14px; color: var(--dvk-text-subtle); margin-top: 16px; }
  .titre-court { max-width: 22ch; margin-top: 14px; }
  .titre-long { max-width: 26ch; margin-top: 14px; }
  .chapo-section { margin-top: 24px; }
  .chaine { margin-top: 48px; }
  .etapes { margin-top: 40px; }
  /* Parcours de 5 et 6 étapes : colonnes régulières sur grand écran (pas d'orpheline), grille d'origine en dessous. */
  .etapes-5 :global(.dvk-process.colonnes) { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .etapes-6 :global(.dvk-process.colonnes) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .etapes-5 :global(.dvk-process.colonnes h3), .etapes-6 :global(.dvk-process.colonnes h3) { font-size: 22px; }
  @media (max-width: 900px) {
    .etapes-5 :global(.dvk-process.colonnes) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
    .etapes-6 :global(.dvk-process.colonnes) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  }
  .zoom { margin-top: 28px; font-weight: 600; }
  .zoom a { color: var(--dvk-action); }

  .demo-grille { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  @media (max-width: 900px) { .demo-grille { grid-template-columns: 1fr; } }
  .demo-grille .chapo { margin-top: 22px; }
  .demo-liste { list-style: none; padding: 0; margin: 28px 0 0; border-top: 1px solid var(--dvk-inverse-subtle); }
  .demo-liste li { padding: 14px 0; border-bottom: 1px solid var(--dvk-inverse-subtle); color: var(--dvk-inverse-muted); }
  .demo-note { margin: 20px 0 0; font-size: 15px; color: var(--dvk-inverse-muted); }
  .demo-fenetre { background: var(--dvk-background); color: var(--dvk-text); border-radius: var(--dvk-radius-md); padding: clamp(18px, 3vw, 32px); }
  .demo-fenetre .surtitre { margin: 0 0 12px; }
  .legende-statuts { list-style: none; padding: 0; margin: 0; border-top: 1.5px solid var(--dvk-text); }
  .legende-statuts li { display: grid; grid-template-columns: 130px 1fr; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--dvk-border); align-items: baseline; font-size: 16px; color: var(--dvk-text-muted); }
  @media (max-width: 720px) { .legende-statuts li { grid-template-columns: 1fr; gap: 6px; } }

  .faq-section { max-width: 1000px; padding-block: 96px 40px; }
  .reglementaire { max-width: 1000px; padding-block: 24px 40px; }
  .final { margin-top: 96px; }
</style>
