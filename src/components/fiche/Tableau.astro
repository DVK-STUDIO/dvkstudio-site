---
// Tableau comparatif lisible sur mobile (défilement horizontal dans son cadre, jamais la page).
interface Props { legende: string; entetes: string[]; lignes: string[][]; note?: string; }
const { legende, entetes, lignes, note } = Astro.props;
---

<figure class="tableau">
  <div class="tableau-cadre" tabindex="0" role="region" aria-label={legende}>
    <table>
      <caption>{legende}</caption>
      <thead><tr>{entetes.map((e) => <th scope="col">{e}</th>)}</tr></thead>
      <tbody>{lignes.map((l) => <tr>{l.map((c, i) => (i === 0 ? <th scope="row" set:html={c} /> : <td data-col={entetes[i]} set:html={c} />))}</tr>)}</tbody>
    </table>
  </div>
  {note && <figcaption set:html={note} />}
</figure>

<style>
  .tableau { margin: 24px 0; }
  .tableau-cadre { overflow-x: auto; border: 1px solid var(--dvk-border); border-radius: var(--dvk-radius-md); }
  table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 520px; }
  caption { text-align: left; font-weight: 600; padding: 14px 16px 6px; }
  th, td { text-align: left; padding: 12px 16px; border-top: 1px solid var(--dvk-border); vertical-align: top; }
  thead th { background: var(--dvk-surface); font-weight: 600; font-size: 14px; }
  tbody th { font-weight: 600; }
  /* Sous 720 px : chaque ligne devient une carte, aucune colonne n'est cachée hors écran. */
  @media (max-width: 720px) {
    .tableau-cadre { overflow-x: visible; border: 0; }
    table { min-width: 0; }
    caption { padding: 0 0 8px; }
    thead { display: none; }
    tbody tr { display: block; border: 1px solid var(--dvk-border); border-radius: var(--dvk-radius-md); margin-bottom: 12px; }
    tbody th, td { display: block; border-top: 0; padding: 8px 16px; }
    tbody th { padding-top: 14px; font-size: 16px; }
    td::before { content: attr(data-col); display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--dvk-text-muted); }
    td:last-child { padding-bottom: 14px; }
  }
  figcaption { font-size: 13px; color: var(--dvk-text-muted); margin-top: 8px; }
</style>
