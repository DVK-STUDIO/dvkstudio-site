---
interface Props { questions: { q: string; r: string }[]; }
const { questions } = Astro.props;
---

<div class="faq">
  {questions.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p>{item.r}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-bottom: 1.5px solid var(--encre); }
  details { border-top: 1px solid var(--ligne); padding: 20px 0; }
  details:first-child { border-top: 1.5px solid var(--encre); }
  summary { cursor: pointer; list-style: none; font-size: 19px; font-weight: 600; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-weight: 400; font-size: 24px; line-height: 1; color: var(--terre-fonce); }
  details[open] summary::after { content: "–"; }
  details p { margin-top: 14px; color: var(--encre-douce); max-width: 70ch; }
</style>
