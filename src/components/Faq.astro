---
interface Props { questions: { q: string; r: string }[]; structure?: boolean; }
// structure : publie aussi les questions en données structurées (FAQPage), lues par Google et les moteurs de réponse IA.
const { questions, structure = true } = Astro.props;
const faqPage = { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": questions.map((i) => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.r } })) };
---

{structure && <script type="application/ld+json" set:html={JSON.stringify(faqPage)}></script>}
<div class="faq">
  {questions.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p>{item.r}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-bottom: 1px solid var(--dvk-border); }
  details { border-top: 1px solid var(--dvk-border); padding: 20px 0; }
  details:first-child { border-top: 1px solid var(--dvk-border-strong); }
  summary { cursor: pointer; list-style: none; font-size: 18px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 44px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; flex: none; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font-weight: 400; font-size: 20px; line-height: 1; color: var(--dvk-action-deep); background: var(--dvk-action-soft); }
  details[open] summary::after { content: "–"; }
  details p { margin-top: 14px; color: var(--dvk-text-muted); max-width: 70ch; }
</style>
