---
import { Image } from 'astro:assets';
import { imageAmbiance } from '../lib/medias';
const photo = imageAmbiance();
---
<section id="simulateur" class="conteneur section" aria-labelledby="simulateur-titre" data-habil-simulator>
  <div class="sim-immersive">
    {photo && <Image class="sim-photo" src={photo.src} alt="" widths={[640,960,1280,1800]} sizes="(max-width: 900px) 100vw, 1120px" loading="lazy" />}
    <div class="sim-content">
      <p class="surtitre">Votre prochain chapitre commence chez vous</p>
      <h2 id="simulateur-titre">Imaginez la suite.<br /><em>Explorez les possibilités.</em></h2>
      <p class="sim-intro">Votre adresse, un premier regard sur votre rénovation.</p>
      <div class="sim-search-card">
        <label for="simulateur-adresse">Quelle est l’adresse de votre bien ?</label>
        <div class="sim-input"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg><input id="simulateur-adresse" type="search" maxlength="200" autocomplete="off" placeholder="Saisissez votre adresse…" aria-describedby="simulateur-info simulateur-etat" /><span aria-hidden="true" class="sim-arrow">→</span></div>
        <div data-results aria-label="Adresses proposées"></div>
        <p id="simulateur-etat" role="status" aria-live="polite">Sélectionnez votre logement pour commencer.</p>
        <div data-selected hidden class="sim-selected"><p data-address></p><a href="https://app.habil.fr/dvk-studio/simulation" data-simulation class="btn btn-action" target="_blank" rel="noopener noreferrer">Découvrir ma simulation <span aria-hidden="true">↗</span></a></div>
        <div class="sim-card-bottom"><span>Simulateur Habil</span><a href="https://app.habil.fr/dvk-studio/simulation" target="_blank" rel="noopener noreferrer">Accès direct ↗</a></div>
      </div>
      <p class="sim-reassurance">Une première estimation pour vous projeter. Aucun devis ni engagement.</p>
    </div>
    <div class="sim-footer"><p id="simulateur-info">Recherche d’adresse : IGN. À l’ouverture, l’adresse et sa localisation sont transmises à Habil. <a href="/confidentialite/">Vos données</a></p><span>Photo d’illustration.</span></div>
  </div>
</section>
<style>
  section { scroll-margin-top:90px; }
  .sim-immersive { position:relative; isolation:isolate; overflow:hidden; min-height:650px; display:flex; flex-direction:column; justify-content:center; background:var(--dvk-night); border-radius:var(--dvk-radius-md); color:var(--dvk-text-inverse); }
  .sim-photo { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; z-index:-3; }
  .sim-immersive::after { content:""; position:absolute; inset:0; background:linear-gradient(90deg,rgba(20,20,20,.84),rgba(20,20,20,.56) 65%,rgba(20,20,20,.3)); z-index:-2; }
  .sim-content { padding:64px clamp(24px,5vw,72px) 36px; max-width:850px; }
  .surtitre { color:var(--dvk-text-inverse); font-size:12px; letter-spacing:.13em; }
  .surtitre::before { background:var(--dvk-accent-on-night); }
  h2 { color:var(--dvk-text-inverse); font-size:clamp(36px,4.2vw,56px); line-height:1.1; letter-spacing:-.035em; margin:26px 0 20px; }
  h2 em { color:var(--dvk-text-inverse); font-weight:400; }
  .sim-intro { font-size:16px; line-height:1.7; color:var(--dvk-text-inverse); margin-bottom:28px; }
  .sim-search-card { color:var(--dvk-text); background:var(--dvk-surface-raised); padding:24px; border-radius:var(--dvk-radius-md); box-shadow:var(--dvk-shadow-card); max-width:600px; }
  label { display:block; font-size:13px; font-weight:600; margin-bottom:12px; }
  .sim-input { display:flex; align-items:center; gap:12px; padding:0 16px; background:var(--dvk-background); border:1px solid var(--dvk-border-strong); border-radius:var(--dvk-radius-sm); }
  .sim-input:focus-within { outline:2px solid var(--dvk-action); outline-offset:3px; }
  .sim-input svg { width:21px; height:21px; flex:none; color:var(--dvk-action); }
  input { min-width:0; width:100%; height:58px; background:transparent; border:0; font:inherit; font-size:15px; color:var(--dvk-text); outline:none; padding:0; }
  input:focus-visible { outline:none; }
  .sim-arrow { font-size:24px; color:var(--dvk-action); }
  [data-results] { display:grid; gap:6px; margin-top:8px; }
  [data-results] :global(button) { padding:12px 14px; font:inherit; font-size:13px; line-height:1.6; text-align:left; cursor:pointer; border:1px solid var(--dvk-border); border-radius:var(--dvk-radius-sm); background:var(--dvk-background); color:var(--dvk-text); }
  [data-results] :global(button:hover) { background:var(--dvk-action-soft); border-color:var(--dvk-action); }
  [role="status"] { font-size:12px; line-height:1.6; margin:8px 0 0; color:var(--dvk-text-muted); }
  .sim-selected { margin-top:18px; }
  .sim-selected p { font-size:13px; font-weight:600; margin-bottom:12px; }
  .sim-selected .btn { width:100%; justify-content:space-between; font-size:14px; }
  .sim-card-bottom { display:flex; align-items:center; justify-content:space-between; gap:12px; padding-top:16px; margin-top:16px; border-top:1px solid var(--dvk-border); font-size:12px; }
  .sim-card-bottom span { color:var(--dvk-text-muted); }
  .sim-card-bottom a { color:var(--dvk-action); }
  .sim-reassurance { font-size:12px; margin-top:18px; color:var(--dvk-text-inverse); }
  .sim-footer { display:flex; justify-content:space-between; gap:24px; padding:12px clamp(24px,5vw,72px) 24px; margin-top:auto; font-size:12px; color:var(--dvk-text-inverse); }
  .sim-footer p { max-width:68ch; font-size:12px; line-height:1.7; }
  .sim-footer a { text-decoration:underline; }
  .sim-footer span { flex:none; align-self:flex-end; }
  :global([data-habil-simulator] button:focus-visible) { outline:3px solid var(--dvk-action); outline-offset:3px; }
  @media(max-width:900px) { .sim-immersive { min-height:0; } .sim-content { padding:40px 24px 24px; } .sim-photo { object-position:65% center; } .sim-immersive::after { background:rgba(20,20,20,.72); } .sim-footer { flex-direction:column; gap:8px; padding:0 24px 24px; } .sim-footer span { align-self:flex-start; } }
  @media(max-width:720px) { h2 { font-size:36px; } .sim-search-card { padding:20px 16px; } .surtitre { letter-spacing:.08em; } .sim-content { padding-inline:20px; } .sim-footer { padding-inline:20px; } }
</style>
<script>
  import { adressesHabil, lienHabil, rechercheAdresse } from '../lib/habil';
  const root = document.querySelector<HTMLElement>('[data-habil-simulator]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('input')!;
    const results = root.querySelector<HTMLElement>('[data-results]')!;
    const status = root.querySelector<HTMLElement>('[role="status"]')!;
    const selected = root.querySelector<HTMLElement>('[data-selected]')!;
    const link = root.querySelector<HTMLAnchorElement>('[data-simulation]')!;
    let timer: ReturnType<typeof setTimeout>;
    let controller: AbortController | undefined;
    let generation = 0;
    input.addEventListener('input', () => {
      clearTimeout(timer); controller?.abort(); const version = ++generation;
      results.replaceChildren(); selected.hidden = true; link.removeAttribute('href');
      const query = input.value.trim();
      status.textContent = query.length < 4 ? 'Saisissez au moins quatre caractères.' : 'Recherche…';
      if (query.length < 4) return;
      timer = setTimeout(async () => {
        const requestController = new AbortController(); controller = requestController;
        const timeout = setTimeout(() => requestController.abort(), 8000);
        try {
          const response = await fetch(rechercheAdresse(query), {signal:requestController.signal,credentials:'omit',referrerPolicy:'no-referrer'});
          if (!response.ok) throw new Error('Recherche indisponible');
          const addresses = adressesHabil(await response.json());
          if (version !== generation) return;
          status.textContent = addresses.length ? 'Choisissez une adresse.' : 'Aucune adresse trouvée. Précisez votre recherche.';
          for (const address of addresses) {
            const button = document.createElement('button'); button.type = 'button';
            button.textContent = `${address.label}${address.context ? ' — ' + address.context : ''}`;
            button.addEventListener('click', () => {
              input.value = address.label; results.replaceChildren();
              root.querySelector<HTMLElement>('[data-address]')!.textContent = address.label;
              link.href = lienHabil(address); selected.hidden = false;
              status.textContent = 'Adresse sélectionnée. Ouvrez votre simulation.'; link.focus();
            }); results.append(button);
          }
        } catch { if (version === generation) status.textContent = 'Recherche indisponible. Réessayez ou utilisez le lien direct vers Habil.'; }
        finally { clearTimeout(timeout); }
      }, 350);
    });
  }
</script>

