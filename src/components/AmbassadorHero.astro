---
// Bulle d'accueil de l'ambassadeur dans le Hero ou en début de page
interface Props {
  text: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  text,
  ctaText,
  ctaHref
} = Astro.props;
---

<div class="ambassador-hero-pill">
  <img
    src="/images/avatar/avatar-zebre-accueil.png"
    alt="Le Zèbre DVK Studio"
    width="48"
    height="48"
    class="pill-avatar"
  />
  <div class="pill-body">
    <p class="pill-text">{text}</p>
    {ctaText && ctaHref && (
      <a href={ctaHref} class="pill-cta">{ctaText} &rarr;</a>
    )}
  </div>
</div>

<style>
  .ambassador-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background: var(--dvk-background, #f7f3ec);
    border: 1px solid var(--dvk-border, #e3dccf);
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    border-radius: var(--dvk-radius-pill);
    box-shadow: var(--dvk-shadow-float, 0 1px 6px rgba(28, 28, 28, 0.08));
    margin-bottom: 1.5rem;
  }

  .pill-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--dvk-primary, #0b4b66);
  }

  .pill-body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
  }

  .pill-text {
    margin: 0;
    color: var(--dvk-text, #1f2a2e);
    font-weight: 500;
  }

  .pill-cta {
    color: var(--dvk-action, #8c5a29);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .pill-cta:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .ambassador-hero-pill {
      border-radius: var(--dvk-radius-md);
      padding: 0.75rem;
    }
    .pill-body {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
