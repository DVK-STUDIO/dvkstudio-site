---
// Une donnée : valeur + statut visibles, sources et précisions en divulgation progressive.
// Un conflit entre sources reste signalé sans ouvrir le détail.
import Statut from "./Statut.astro";
import { afficherValeur, afficherConflit, libelleSources, type Valeur, type Source } from "../../lib/experience/experience";
interface Props { libelle: string; valeur: Valeur; sources: Source[]; grand?: boolean }
const { libelle, valeur, sources, grand = false } = Astro.props;
const noms = libelleSources(valeur.sources, sources);
const conflits = valeur.conflits ?? [];
const vide = valeur.statut === "manquant" || valeur.statut === "a_venir";
// Une lacune affiche son explication directement ; les autres gardent la note dans le détail.
const aDetail = noms.length > 0 || (!!valeur.note && !vide) || conflits.length > 0;
---

<div class:list={["donnee", { grand }]}>
  <dt>{libelle}</dt>
  <dd>
    {!vide && <span class="val">{afficherValeur(valeur)}</span>}
    <Statut statut={valeur.statut} />
    {vide && valeur.note && <p class="lacune">{valeur.note}</p>}
    {conflits.length > 0 && <p class="alerte">Les sources ne sont pas d'accord sur ce point.</p>}
    {aDetail && (
      <details>
        <summary>D'où vient cette donnée ?</summary>
        <div class="detail">
          {valeur.note && <p>{valeur.note}</p>}
          {noms.length > 0 && <p class="src">Source : {noms.join(", ")}.</p>}
          {conflits.length > 0 && (
            <ul class="conflits">
              {conflits.map((c) => (
                <li>
                  <strong>{afficherConflit(c)}</strong> : {libelleSources(c.sources, sources).join(", ")}.{c.note ? ` ${c.note}` : ""}
                </li>
              ))}
            </ul>
          )}
        </div>
      </details>
    )}
  </dd>
</div>

<style>
  .donnee { padding: 16px 0; border-top: 1px solid var(--ligne); display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; }
  dt { font-size: 14px; color: var(--pierre); }
  dd { margin: 0; }
  .val { font-family: var(--serif); font-size: 24px; line-height: 1.2; margin-right: 8px; overflow-wrap: anywhere; }
  .grand .val { font-size: clamp(30px, 4vw, 44px); }
  .lacune { margin-top: 8px; font-size: 16px; color: var(--encre-douce); max-width: 56ch; }
  .alerte { margin-top: 6px; font-size: 14px; color: #7b2f1d; font-weight: 600; }
  details { margin-top: 8px; }
  summary { cursor: pointer; font-size: 14px; color: var(--petrole); min-height: 28px; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: 3px; }
  .detail { margin-top: 8px; padding: 12px 14px; background: var(--papier-2); border-radius: var(--rayon); font-size: 15px; color: var(--encre-douce); }
  .detail p + p, .detail p + ul { margin-top: 8px; }
  .src { color: var(--pierre); font-size: 14px; }
  .conflits { list-style: none; padding: 0; display: grid; gap: 6px; }
</style>
