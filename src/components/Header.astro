---
import { Image } from "astro:assets";
import { navigation } from "../content/navigation";
import { CALENDLY_BASE } from "../lib/calendly";
import symbole from "../assets/logo/dvk-logo-symbole.png";
interface Props { page: string }
const { page } = Astro.props;
const courant = (href: string) => (href === `/${page}/` ? "page" : undefined);
---

<header class="entete">
  <div class="conteneur entete-interieur">
    <a href="/" class="marque" aria-label="DVK Studio — accueil">
      <!-- Symbole du logo officiel (fichier transparent fourni, rogné sans retouche). Le logo complet est dans le pied de page. -->
      <Image class="marque-symbole" src={symbole} width={82} height={67} format="webp" alt="" loading="eager" />
      <span class="marque-nom">DVK Studio</span><span class="marque-zone">Oise · Somme</span>
    </a>
    <nav aria-label="Navigation principale" class="nav" id="nav-principale">
      <ul>
        {navigation.map((n) => (
          <li>
            <a href={n.href} aria-current={courant(n.href)}>
              {n.libelle}
              {n.badge && <span class="badge">{n.badge}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={CALENDLY_BASE} class="btn btn-action entete-cta" data-rdv="nav.rdv" target="_blank" rel="noopener">Faire le point · 30 min</a>
    <button type="button" class="menu-bouton" aria-expanded="false" aria-controls="nav-principale" aria-label="Ouvrir le menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .entete { padding-block: 16px; position: relative; z-index: 10; border-bottom: 1px solid var(--dvk-border); }
  .entete-interieur { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .marque { display: flex; align-items: center; min-height: 44px; gap: 12px; }
  .marque-symbole { height: 34px; width: auto; flex: none; }
  .marque-nom { font-size: 15px; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 600; white-space: nowrap; }
  .marque-zone { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--pierre); font-weight: 600; padding-left: 12px; border-left: 1px solid var(--dvk-border); }
  .nav ul { list-style: none; display: flex; gap: 22px; }
  .nav a { font-size: 13.5px; letter-spacing: 0.01em; font-weight: 400; white-space: nowrap; display: inline-flex; align-items: center; gap: 8px; padding-block: 8px; }
  .nav a[aria-current="page"] { border-bottom: 2px solid var(--terre); font-weight: 600; }
  .badge { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; background: var(--encre); color: var(--papier); padding: 3px 8px; border-radius: var(--dvk-radius-pill); }
  .entete-cta { min-height: 44px; padding: 0 20px; font-size: 13.5px; white-space: nowrap; }
  .menu-bouton { display: none; width: 44px; height: 44px; border: 1.5px solid var(--encre); background: transparent; border-radius: 50%; flex-direction: column; gap: 5px; align-items: center; justify-content: center; cursor: pointer; }
  .menu-bouton span { width: 18px; height: 1.5px; background: var(--encre); display: block; }
  @media (max-width: 900px) {
    .menu-bouton { display: flex; }
    .entete-cta { display: none; }
    .nav { position: absolute; inset: 100% 0 auto 0; background: var(--papier); border-bottom: 1px solid var(--ligne); display: none; padding: 8px var(--gouttiere) 20px; }
    .nav.ouvert { display: block; }
    .nav ul { flex-direction: column; gap: 4px; }
    .nav a { font-size: 17px; padding-block: 12px; }
  }
  @media (max-width: 720px) {
    .marque-nom { font-size: 13px; letter-spacing: 0.2em; }
    .marque-zone { display: none; }
  }
</style>

<script>
  const bouton = document.querySelector<HTMLButtonElement>(".menu-bouton");
  const nav = document.getElementById("nav-principale");
  bouton?.addEventListener("click", () => {
    const ouvert = nav?.classList.toggle("ouvert") ?? false;
    bouton.setAttribute("aria-expanded", String(ouvert));
    bouton.setAttribute("aria-label", ouvert ? "Fermer le menu" : "Ouvrir le menu");
  });
</script>

