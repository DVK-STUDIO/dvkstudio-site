---
import Base from "../layouts/Base.astro";
import BoutonRdv from "../components/BoutonRdv.astro";
import Faq from "../components/Faq.astro";
import { site } from "../content/site";
import { reglementaire } from "../content/iad";

const faq = [
  { q: "Qui est mon interlocuteur ?", r: "Kevin De Vlieger, de DVK Studio. Pour la partie immobilière, j'interviens en tant que mandataire du réseau IAD France." },
  { q: "Pourquoi parler de travaux quand on achète ou on vend ?", r: "Parce que les travaux, ou leur incertitude, sont souvent ce qui bloque une vente ou fait renégocier un achat. Les chiffrer et les montrer tôt rassure tout le monde." },
  { q: "Combien cela coûte-t-il ?", r: "Le premier échange de vingt minutes est sans engagement. Les conditions de chaque prestation vous sont communiquées avant tout engagement." },
];
---

<Base
  titre="Immobilier : acheter ou vendre avec un regard sur le potentiel"
  description="Vendre ou acheter un bien en Oise avec DVK Studio : estimation, valorisation, analyse du potentiel et enveloppe de travaux avant de signer."
  page="immobilier"
  chemin="/immobilier/"
>
  <header class="conteneur page-hero">
    <p class="surtitre">Immobilier · {site.zone}</p>
    <h1 class="titre-xl">Acheter ou vendre, en sachant ce que le bien peut devenir.</h1>
    <p class="chapo">Un bien se juge rarement sur ce qu'il est aujourd'hui, mais sur ce qu'on imagine pouvoir en faire. DVK Studio vous aide à voir clair, côté acheteur comme côté vendeur.</p>
    <div class="actions"><BoutonRdv bouton="hero.rdv" parcours="immobilier">Échanger 20 minutes</BoutonRdv></div>
  </header>

  <section id="vendre" class="section conteneur" aria-labelledby="t-vendre">
    <p class="surtitre">Je vends</p>
    <h2 id="t-vendre" class="titre-l" style="margin-top:14px;max-width:22ch">Mon bien tarde à se vendre.</h2>
    <div class="bloc">
      <div><h3>Le problème</h3><p>Des visites sans suite, un prix difficile à justifier, des acquéreurs qui renégocient parce qu'ils ne savent pas ce que coûteront les travaux.</p></div>
      <div><h3>Ce que fait DVK Studio</h3><p>Une estimation argumentée, une mise en valeur du bien, et, quand il a du potentiel, la présentation de ce qu'il peut devenir : transformations possibles, travaux, enveloppe indicative.</p></div>
      <div><h3>Pour vous, concrètement</h3><p>Un discours clair à donner aux acquéreurs, et un bien compris plus vite. La mise en vente se fait via le réseau IAD France.</p></div>
    </div>
    <div class="actions"><BoutonRdv bouton="vendre.rdv" parcours="vendre">Estimer mon bien</BoutonRdv></div>
  </section>

  <section id="acheter" class="papier-2 section" aria-labelledby="t-acheter">
    <div class="conteneur">
      <p class="surtitre">J'achète</p>
      <h2 id="t-acheter" class="titre-l" style="margin-top:14px;max-width:22ch">Ce bien me plaît, mais je n'arrive pas à me projeter.</h2>
      <div class="bloc">
        <div><h3>Le problème</h3><p>On visite un bien daté ou à rénover sans savoir ce qu'on peut en faire, ni combien cela coûterait, ni si le projet global tient dans son budget.</p></div>
        <div><h3>Ce que fait DVK Studio</h3><p>Analyse du potentiel, scénarios de transformation, enveloppe de travaux indicative et lecture du projet global : prix d'achat plus travaux.</p></div>
        <div><h3>Pour vous, concrètement</h3><p>Une décision d'achat prise avec les bonnes informations, et un interlocuteur qui peut ensuite cadrer les travaux.</p></div>
      </div>
      <div class="actions"><BoutonRdv bouton="acheter.rdv" parcours="acheter">Analyser un bien avant d'acheter</BoutonRdv></div>
    </div>
  </section>

  <section class="section conteneur" aria-labelledby="t-confiance">
    <div class="duo">
      <div>
        <h2 id="t-confiance" class="titre-m">Pourquoi faire confiance à DVK Studio</h2>
        <p class="chapo" style="margin-top:18px">Je suis mandataire du réseau IAD France et chef de projet travaux hemea, sous le nom DVK Studio. Vous gardez un seul interlocuteur, et je vous explique avant tout engagement qui fait quoi.</p>
        <p class="a-completer" style="margin-top:18px;display:inline-block">Informations réglementaires du mandataire : {reglementaire.carteProfessionnelle}</p>
      </div>
      <div><Faq questions={faq} /></div>
    </div>
  </section>
</Base>
